#!/bin/bash
# Let the Mac simmer: awake for a bounded time, lid closed, then off by itself.
#
# Why not `caffeinate`: its assertions prevent idle sleep, but not lid sleep. On
# Apple silicon the machine sleeps when you close the lid even with caffeinate
# holding an assertion. Staying awake with the lid shut requires
# `pmset -a disablesleep 1`.
#
# And that is exactly the trap: `disablesleep` is a switch with no way back. It
# survives reboots, nothing on screen indicates it, and whoever forgets it finds
# a flat battery in their bag. (That is precisely what happened here on day one --
# it stayed on for hours.)
#
# So nothing is switched here, it is *borrowed*: every grant has a deadline, and
# it is handed back by `simmer guard` under launchd -- not by memory. Four things
# end a lease and only one of them is remembering:
#
#   1. the deadline passes
#   2. the battery drops below the floor
#   3. `simmer down`
#   4. the guard finds `disablesleep=1` with no lease (this heals stray pmset
#      runs, including the ones you type yourself)
#
#   simmer 60m -r "claude: funnel refactor"  lease for 60 minutes
#   simmer 2h --min-battery 30               custom battery floor
#   simmer --until 23:00                     absolute time instead of duration
#   simmer forever -r "long run"             no deadline, reminder every 30 min
#   simmer                                   status
#   simmer +20m                              extend
#   simmer down                              hand it back now
#   simmer 1h --force                        replace someone else's lease
#   simmer 1h --owner agent                  say who is asking (else: terminal/script)
#   simmer doctor                            guard, sudo rule, notifications
#   simmer --version
#
#   simmer budget                            how much room is left (for agents)
#   simmer budget --need 20m                 exit 0 if it fits, 1 if not, 3 if no lease
#   simmer budget --seconds                  bare seconds left (-1 = no deadline)
set -euo pipefail

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/simmer"
LEASE="$STATE/lease"
LOG="$STATE/simmer.log"
PMSET=/usr/bin/pmset
SIMMER_VERSION="1.0.0"
GUARD_LABEL=com.github.moralesl.simmer-guard
LEASE_FORMAT=1

DEFAULT_MIN_BATTERY=20
WARN_SECONDS=300      # a single warning, 5 minutes before expiry
REMIND_SECONDS=1800   # with `forever`: remind every 30 minutes

die() { echo "simmer: $*" >&2; exit 1; }

mkdir -p "$STATE"

############################################################################
### Reading and writing the lease
#
# A flat key=value file rather than JSON: the menu bar and Alfred read it too,
# and `jq` should not become a prerequisite for either.

lease_until=0; lease_started=0; lease_reason=""; lease_min_battery=$DEFAULT_MIN_BATTERY
lease_caffeinate=0; lease_warned=0; lease_reminded=0; lease_owner=""; lease_format=1

read_lease() {
  [ -f "$LEASE" ] || return 1
  lease_until=0; lease_started=0; lease_reason=""
  lease_min_battery=$DEFAULT_MIN_BATTERY
  lease_caffeinate=0; lease_warned=0; lease_reminded=0; lease_owner=""
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      until)        lease_until="$value" ;;
      started)      lease_started="$value" ;;
      reason)       lease_reason="$value" ;;
      min_battery)  lease_min_battery="$value" ;;
      caffeinate)   lease_caffeinate="$value" ;;
      warned)       lease_warned="$value" ;;
      reminded)     lease_reminded="$value" ;;
      owner)        lease_owner="$value" ;;
      format)       lease_format="$value" ;;
    esac
  done < "$LEASE"
  return 0
}

write_lease() {
  # Write in full, then rename: the guard must never read half a lease and
  # conclude it is corrupt.
  local tmp="$LEASE.$$"
  {
    # A format number so a later change is detectable instead of being read
    # as garbage by whichever binary happens to be installed.
    echo "format=$LEASE_FORMAT"
    echo "until=$lease_until"
    echo "started=$lease_started"
    echo "reason=$lease_reason"
    echo "min_battery=$lease_min_battery"
    echo "caffeinate=$lease_caffeinate"
    echo "warned=$lease_warned"
    echo "reminded=$lease_reminded"
    echo "owner=$lease_owner"
  } > "$tmp"
  mv -f "$tmp" "$LEASE"
}

log() { printf '%s  %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

############################################################################
### System state

# The three readings and the one write, funnelled through four functions so the
# test suite can substitute them. Without this seam a test of the guard has to
# flip real disablesleep -- which needs sudo, changes the machine under you, and
# makes the battery branch untestable while charging. SIMMER_FAKE_* is read only
# here and documented in ARCHITECTURE.md.
sleep_disabled() {
  if [ -n "${SIMMER_FAKE_PMSET:-}" ]; then
    [ "$(cat "$SIMMER_FAKE_PMSET" 2>/dev/null || echo 0)" = 1 ]
  else
    $PMSET -g live 2>/dev/null | grep -q 'SleepDisabled[[:space:]]*1'
  fi
}

battery_percent() {
  if [ -n "${SIMMER_FAKE_BATTERY:-}" ]; then printf '%s' "${SIMMER_FAKE_BATTERY%%:*}"
  else $PMSET -g batt | grep -oE '[0-9]+%' | head -1 | tr -d '%'; fi
}

on_battery() {
  if [ -n "${SIMMER_FAKE_BATTERY:-}" ]; then [ "${SIMMER_FAKE_BATTERY##*:}" = 1 ]
  else $PMSET -g batt | grep -q "'Battery Power'"; fi
}

battery_line() {
  local pct; pct="$(battery_percent)"
  if on_battery; then echo "battery ${pct}%"; else echo "on AC, battery ${pct}%"; fi
}

# Flipping the switch needs root. The guard runs unattended and must therefore
# *never* ask for a password -- `sudo -n` or nothing. Interactively a prompt is
# fine; without the sudo rule from sudoers.d/simmer it would appear on every lease.
set_disablesleep() { # <0|1>
  if [ -n "${SIMMER_FAKE_PMSET:-}" ]; then printf '%s' "$1" > "$SIMMER_FAKE_PMSET"; return 0; fi
  sudo -n $PMSET -a disablesleep "$1" 2>/dev/null && return 0
  [ "${SIMMER_NONINTERACTIVE:-0}" = 1 ] && return 1
  [ -t 0 ] || return 1
  echo "simmer: needs sudo once (to stop being asked: simmer doctor)" >&2
  sudo $PMSET -a disablesleep "$1"
}

############################################################################
### Feedback
#
# Three lines rather than two: title says which state, subtitle the number that
# matters, body the reason. A banner reading "no reason given" spent its widest
# line on the absence of information -- now the reason line is simply omitted
# when there is none, and the space goes to something useful.
# Notifications, in order of preference, and the ordering is the whole story.
#
# The plan was simmer's own app bundle, so banners would carry simmer's name and
# icon. That does not work: an AppleScript applet's `display notification` is
# attributed to the OSA host -- Script Editor -- and not to the applet, so the
# bundle's identity never applies. Tested; the banners arrive grouped under
# "Script Editor" regardless.
#
# Which leaves two channels that do have a real identity:
#
#   1. SwiftBar, if it is running. Its banners actually appear, it is already the
#      documented dependency for the menu bar, and clicking one opens the menu.
#      The icon is SwiftBar's, not simmer's -- honest, and better than a quill.
#   2. osascript. Posts as Script Editor, whose alert style is often set to
#      "none", in which case the notification is delivered but never shown. This
#      is the reason it is second, not first.
#
# Owning the icon needs a signed app bundle. That is a notarisation project, not
# a shell script, and it is recorded as a limitation rather than pretended away.
#
# The sound is not decoration: it is the channel that carries when a banner is
# suppressed, and the menu bar is the indicator nothing can drop.
notify() { # <title> <subtitle> <body> [system sound]
  local title="$1" subtitle="$2" body="$3"
  if [ -d /Applications/SwiftBar.app ] && pgrep -qx SwiftBar 2>/dev/null; then
    open -g "swiftbar://notify?plugin=simmer&title=$(urlencode "$title")&subtitle=$(urlencode "$subtitle")&body=$(urlencode "$body")&silent=true" \
      >/dev/null 2>&1 || notify_via_osascript "$title" "$subtitle" "$body"
  else
    notify_via_osascript "$title" "$subtitle" "$body"
  fi
  [ -n "${4:-}" ] && [ -f "/System/Library/Sounds/$4.aiff" ] &&
    (afplay -v 0.5 "/System/Library/Sounds/$4.aiff" >/dev/null 2>&1 &)
  return 0
}

# Byte-wise under LC_ALL=C, so multi-byte characters in a reason survive the
# round trip instead of being mangled a character at a time.
urlencode() {
  local LC_ALL=C s="$1" out="" i c
  for (( i=0; i<${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out="$out$c" ;;
      *) out="$out$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

notify_via_osascript() { # <title> <subtitle> <body>
  local title="${1//\"/\\\"}" subtitle="${2//\"/\\\"}" body="${3//\"/\\\"}"
  local script="display notification \"$body\" with title \"$title\""
  [ -n "$subtitle" ] && script="$script subtitle \"$subtitle\""
  osascript -e "$script" 2>/dev/null || true
}

# The menu bar polls its own state every 10 seconds; this is only for the
# immediate feel right after a command. If SwiftBar is absent it costs nothing.
refresh_menubar() {
  [ -d /Applications/SwiftBar.app ] || return 0
  open -g "swiftbar://refreshplugin?name=simmer" >/dev/null 2>&1 || true
  return 0
}

############################################################################
### Who took the lease
#
# The owner is what makes the refusal below possible, so it has to be more
# specific than "a shell": every surface here would otherwise report the same
# thing. Launchers export SIMMER_OWNER; a terminal is recognised by its tty;
# anything else is a script, which is also what an agent looks like unless it
# says otherwise. Agents should export SIMMER_OWNER=agent so the refusal can
# name them.
current_owner() {
  if [ -n "${SIMMER_OWNER:-}" ]; then printf '%s' "$SIMMER_OWNER"
  elif [ -t 0 ]; then printf 'terminal'
  else printf 'script'; fi
}

############################################################################
### Durations and times

# 90 | 90m | 1h | 1h30m | 45min | 2h15
parse_duration() { # <text> -> seconds
  # tr rather than ${1,,}: the shebang is /bin/bash, which on macOS is still
  # 3.2, and lowercasing expansions arrived in bash 4. Staying on /bin/bash is
  # deliberate -- a launchd job should not depend on a Homebrew shell.
  local text total=0 rest
  text="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  rest="$text"
  [[ "$text" =~ ^[0-9]+$ ]] && { echo $((text * 60)); return 0; }
  local matched=0
  while [[ "$rest" =~ ^([0-9]+)(h|hours?|m|min|minutes?|s|sec|seconds?)(.*)$ ]]; do
    local n="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
    rest="${BASH_REMATCH[3]}"
    case "$unit" in
      h|hour|hours) total=$((total + n * 3600)) ;;
      s|sec|second|seconds) total=$((total + n)) ;;
      *) total=$((total + n * 60)) ;;
    esac
    matched=1
  done
  # "2h15" -- a trailing bare number means minutes
  [[ "$rest" =~ ^[0-9]+$ ]] && { total=$((total + rest * 60)); rest=""; }
  [ "$matched" = 1 ] && [ -z "$rest" ] && [ "$total" -gt 0 ] && { echo "$total"; return 0; }
  return 1
}

# HH:MM -> epoch. If the time is already behind us, tomorrow is meant.
parse_until() { # <HH:MM> -> epoch
  [[ "$1" =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || return 1
  local target; target="$(date -j -f '%Y-%m-%d %H:%M' "$(date '+%Y-%m-%d') $1" '+%s' 2>/dev/null)" || return 1
  [ "$target" -le "$(date +%s)" ] && target=$((target + 86400))
  echo "$target"
}

human_duration() { # <seconds> -> "1 h 20 min"
  local s="$1"
  [ "$s" -lt 0 ] && s=0
  local h=$((s / 3600)) m=$(((s % 3600) / 60))
  if [ "$h" -gt 0 ]; then echo "${h} h ${m} min"
  elif [ "$m" -gt 0 ]; then echo "${m} min"
  else echo "under 1 min"; fi
}

short_duration() { # <seconds> -> "1h20" / "42m" -- for the menu bar
  local s="$1"
  [ "$s" -lt 0 ] && s=0
  local h=$((s / 3600)) m=$(((s % 3600) / 60))
  if [ "$h" -gt 0 ]; then printf '%dh%02d\n' "$h" "$m"
  else printf '%dm\n' "$m"; fi
}

############################################################################
### Taking and returning a lease

release() { # <reason> [system sound]
  local why="$1" sound="${2:-Blow}" had_lease=0
  if read_lease; then
    had_lease=1
    [ "$lease_caffeinate" != 0 ] && kill "$lease_caffeinate" 2>/dev/null || true
  fi
  rm -f "$LEASE"

  if sleep_disabled; then
    if set_disablesleep 0; then
      log "released ($why)"
      notify "⏾ Sleep allowed again" "$why" "" "$sound"
    else
      # The one way the guard can fail: no sudo rule. This must not happen
      # quietly -- otherwise the machine simply stays awake.
      log "ERROR: could not revert disablesleep ($why)"
      notify "⚠️ simmer could not release" "disablesleep is still on" \
             "Run 'simmer doctor' in a terminal." "Basso"
      refresh_menubar
      return 1
    fi
  elif [ "$had_lease" = 1 ]; then
    log "lease removed, disablesleep was already off ($why)"
  fi
  refresh_menubar
}

cmd_take() {
  local seconds=0 until_epoch=0 reason="" min_battery=$DEFAULT_MIN_BATTERY forever=0 force=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -r|--reason)      reason="${2:-}"; shift 2 ;;
      --min-battery)    min_battery="${2:-}"; shift 2 ;;
      --until)          until_epoch="$(parse_until "${2:-}")" || die "did not understand the time: ${2:-} (expected HH:MM)"; shift 2 ;;
      forever|--forever|--indefinite) forever=1; shift ;;
      -f|--force)       force=1; shift ;;
      # A flag as well as SIMMER_OWNER, because SwiftBar can pass arguments to a
      # menu action but cannot set environment variables for it.
      --owner)          SIMMER_OWNER="${2:-}"; shift 2 ;;
      -*)               die "unknown option: $1" ;;
      *)                seconds="$(parse_duration "$1")" || die "did not understand the duration: $1 (e.g. 60m, 2h, 1h30m)"; shift ;;
    esac
  done

  [[ "$min_battery" =~ ^[0-9]+$ ]] || die "--min-battery expects a number"

  local now; now="$(date +%s)"
  if [ "$forever" = 1 ]; then
    until_epoch=0
  elif [ "$until_epoch" = 0 ]; then
    [ "$seconds" -gt 0 ] || die "no duration given. 'simmer 60m', 'simmer --until 23:00' or 'simmer forever'"
    until_epoch=$((now + seconds))
  fi

  # Check the battery floor before flipping the switch: a lease the guard
  # reclaims on its very next tick is only confusing.
  local pct; pct="$(battery_percent)"
  if on_battery && [ "$pct" -le "$min_battery" ]; then
    notify "⚠️ simmer refused" "Battery ${pct}%, floor ${min_battery}%" \
           "Plug in, or lower --min-battery." "Basso"
    die "battery ${pct}% <= floor ${min_battery}%. Plug in, or lower --min-battery."
  fi

  # An existing lease is replaced, not stacked -- but not silently, and not
  # across owners. The case this exists for: an agent takes a two hour lease and
  # stamps over the twenty minutes a human deliberately set, and the human finds
  # out when the machine does not sleep. Same owner replacing its own lease is
  # ordinary and stays silent.
  if read_lease; then
    local mine; mine="$(current_owner)"
    if [ -n "$lease_owner" ] && [ "$lease_owner" != "$mine" ] && [ "$force" = 0 ]; then
      if [ "$lease_until" = 0 ]; then
        echo "simmer: $lease_owner holds an open-ended lease${lease_reason:+ ($lease_reason)}." >&2
      else
        echo "simmer: $lease_owner holds a lease until $(date -r "$lease_until" '+%H:%M')${lease_reason:+ ($lease_reason)}." >&2
      fi
      die "replace it with --force, extend it with 'simmer +<duration>', or end it with 'simmer down'"
    fi
    [ "$lease_caffeinate" != 0 ] && kill "$lease_caffeinate" 2>/dev/null || true
  fi

  set_disablesleep 1 || die "could not set disablesleep (sudo?). Run 'simmer doctor'"

  # A second, independent clock: caffeinate holds display and idle open and ends
  # on its own via -t. If the guard dies, at least this one still expires.
  #
  # nohup, because otherwise closing the terminal that started the lease sends
  # SIGHUP to this background child and the second clock quietly disappears.
  #
  # -dims without -u: -u asserts *user activity* and, given no -t, lasts all of
  # five seconds -- so in the open-ended branch it would look like an assertion
  # and be none. -d already keeps the display up, which makes -u redundant
  # either way.
  local caff_pid=0
  if [ "$until_epoch" != 0 ]; then
    nohup caffeinate -dims -t $((until_epoch - now)) >/dev/null 2>&1 &
    caff_pid=$!
  else
    nohup caffeinate -dims >/dev/null 2>&1 &
    caff_pid=$!
  fi

  lease_until="$until_epoch"; lease_started="$now"; lease_reason="$reason"
  lease_min_battery="$min_battery"; lease_caffeinate="$caff_pid"
  lease_warned=0; lease_reminded="$now"; lease_owner="$(current_owner)"
  write_lease

  if [ "$until_epoch" = 0 ]; then
    log "took: no deadline${reason:+ ($reason)}, battery floor ${min_battery}%"
    echo "☕ simmering, no deadline${reason:+ · $reason}"
    echo "   reminder every 30 min · releases below ${min_battery}% battery · 'simmer down' ends it"
    notify "☕ Simmering, no deadline" "reminder every 30 min · floor ${min_battery}%" \
           "${reason:-Ends with simmer down.}" "Submarine"
  else
    log "took: until $(date -r "$until_epoch" '+%H:%M')${reason:+ ($reason)}, battery floor ${min_battery}%"
    echo "☕ simmering until $(date -r "$until_epoch" '+%H:%M') ($(human_duration $((until_epoch - now))))${reason:+ · $reason}"
    echo "   lid may close · $(battery_line) · releases below ${min_battery}%"
    notify "☕ Simmering until $(date -r "$until_epoch" '+%H:%M')" \
           "$(human_duration $((until_epoch - now))) · lid may close" \
           "${reason:-}" "Submarine"
  fi
  refresh_menubar
}

cmd_extend() {
  local arg="${1:-}"; arg="${arg#+}"
  [ -n "$arg" ] || die "extend by how much? 'simmer +20m'"
  local seconds; seconds="$(parse_duration "$arg")" || die "did not understand the duration: $arg"
  read_lease || die "no lease to extend. 'simmer ${arg}' takes a new one."
  [ "$lease_until" = 0 ] && die "this lease has no deadline -- there is nothing to extend."

  # From now, not from the old deadline: after "+20m" twenty minutes should be
  # left, not twenty plus whatever remained.
  local now; now="$(date +%s)"
  lease_until=$((now + seconds))
  lease_warned=0
  write_lease
  log "extended until $(date -r "$lease_until" '+%H:%M')"
  echo "☕ simmering until $(date -r "$lease_until" '+%H:%M') ($(human_duration "$seconds"))"
  notify "☕ Extended until $(date -r "$lease_until" '+%H:%M')" "$(human_duration "$seconds") left" \
         "${lease_reason:-}" "Pop"
  refresh_menubar
}

############################################################################
### Status

cmd_status() {
  local porcelain=0
  case "${1:-}" in --machine|--porcelain) porcelain=1 ;; esac

  local now; now="$(date +%s)"
  if ! read_lease; then
    if sleep_disabled; then
      # Either set by hand, or the guard is not running. Both deserve saying.
      [ "$porcelain" = 1 ] && { echo "state=orphan"; echo "battery=$(battery_percent)"; return 0; }
      echo "⚠️  disablesleep is on but there is no lease -- nobody will hand it back."
      echo "   'simmer down' reverts it, 'simmer 60m' turns it into a proper lease."
      return 0
    fi
    [ "$porcelain" = 1 ] && { echo "state=idle"; echo "battery=$(battery_percent)"; return 0; }
    echo "⏾ sleep allowed · $(battery_line)"
    return 0
  fi

  local left=0
  [ "$lease_until" != 0 ] && left=$((lease_until - now))

  if [ "$porcelain" = 1 ]; then
    echo "state=$([ "$lease_until" = 0 ] && echo forever || echo active)"
    echo "until=$lease_until"
    echo "left=$left"
    echo "left_short=$([ "$lease_until" = 0 ] && echo "∞" || short_duration "$left")"
    echo "reason=$lease_reason"
    echo "min_battery=$lease_min_battery"
    echo "battery=$(battery_percent)"
    echo "on_battery=$(on_battery && echo 1 || echo 0)"
    echo "sleep_disabled=$(sleep_disabled && echo 1 || echo 0)"
    echo "since=$lease_started"
    return 0
  fi

  if [ "$lease_until" = 0 ]; then
    echo "☕ simmering, no deadline · for $(human_duration $((now - lease_started)))${lease_reason:+ · $lease_reason}"
  else
    echo "☕ simmering until $(date -r "$lease_until" '+%H:%M') · $(human_duration "$left") left${lease_reason:+ · $lease_reason}"
  fi
  echo "   $(battery_line) · floor ${lease_min_battery}%"
  sleep_disabled || echo "   ⚠️  disablesleep is off despite the lease -- the lid will not hold. 'simmer doctor'"
}

############################################################################
### budget -- the agent-facing question
#
# `--porcelain` says what the state IS. An agent needs to decide whether to
# START something: "is there room for another ten minutes of work, or do I write
# the handoff note instead?" Answering that from the raw seconds means every
# caller reimplements the same comparison, and gets the no-lease case wrong.
#
# So the decision lives here, in the exit code:
#
#   0  there is room (or no deadline at all)
#   1  not enough time left -- wind down
#   3  no lease: sleep is allowed and the lid can interrupt at any moment
#
# 3 rather than 1 for "no lease" on purpose: it is not a small budget, it is an
# absent guarantee. A caller that treats those the same will keep working while
# the machine sleeps under it.

cmd_budget() {
  local need_seconds=0 bare=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --need)    need_seconds="$(parse_duration "${2:-}")" || die "did not understand the duration: ${2:-}"; shift 2 ;;
      # A bare integer, because the alternative is every caller regex-ing an
      # English sentence. -1 means no deadline. Only meaningful when the exit
      # code is 0 -- check that first.
      --seconds) bare=1; shift ;;
      *)         die "usage: simmer budget [--need 20m] [--seconds]" ;;
    esac
  done

  local now; now="$(date +%s)"
  if ! read_lease; then
    if [ "$bare" = 0 ]; then
      if sleep_disabled; then
        echo "sleep disabled with no lease -- nobody will hand it back"
      else
        echo "no lease -- sleep is allowed, the lid can interrupt at any time"
      fi
    fi
    return 3
  fi

  if [ "$lease_until" = 0 ]; then
    if [ "$bare" = 1 ]; then echo "-1"
    else echo "no deadline -- running for $(human_duration $((now - lease_started)))${lease_reason:+ · $lease_reason}"; fi
    return 0
  fi

  local left=$((lease_until - now))
  local total=$((lease_until - lease_started))
  if [ "$bare" = 1 ]; then echo "$left"
  else echo "$(human_duration "$left") left of $(human_duration "$total") · until $(date -r "$lease_until" '+%H:%M')${lease_reason:+ · $lease_reason}"; fi
  [ "$need_seconds" -gt 0 ] && [ "$left" -lt "$need_seconds" ] && return 1
  return 0
}

############################################################################
### The guard
#
# Runs every 30 seconds under launchd, and at login. It is the reason this tool
# is safe to carry around: handing the switch back does not depend on a terminal
# you closed or a process you killed.

cmd_guard() {
  export SIMMER_NONINTERACTIVE=1
  local now; now="$(date +%s)"

  if ! read_lease; then
    # No lease but the switch is on: set by hand, or a crash mid-release. Either
    # way it goes back -- this is the self-healing that makes the forgotten
    # switch structurally impossible.
    if sleep_disabled; then
      release "found disablesleep with no lease" "Basso" || exit 1
    fi
    exit 0
  fi

  # Deadline passed
  if [ "$lease_until" != 0 ] && [ "$now" -ge "$lease_until" ]; then
    release "time is up$([ -n "$lease_reason" ] && echo " · $lease_reason")"
    exit 0
  fi

  # Battery below the floor. Only on battery power -- on AC the charge level is
  # irrelevant, and while charging this would abort for no reason.
  local pct; pct="$(battery_percent)"
  if on_battery && [ -n "$pct" ] && [ "$pct" -le "$lease_min_battery" ]; then
    release "battery ${pct}% below floor ${lease_min_battery}%" "Basso"
    exit 0
  fi

  # Did something else flip the switch? Inside a lease it gets restored,
  # otherwise the lid stops holding.
  if ! sleep_disabled; then
    if set_disablesleep 1; then
      log "disablesleep was off and was restored inside the lease"
    else
      log "ERROR: could not restore disablesleep"
    fi
  fi

  # One warning, exactly once
  if [ "$lease_until" != 0 ]; then
    local left=$((lease_until - now))
    if [ "$left" -le "$WARN_SECONDS" ] && [ "$lease_warned" = 0 ]; then
      lease_warned=1; write_lease
      notify "☕ $(human_duration "$left") left" "then this Mac sleeps" \
             "simmer +30m extends it.${lease_reason:+ · $lease_reason}" "Tink"
      refresh_menubar
    fi
  else
    # No deadline: remind regularly. An open-ended lease must be impossible to
    # forget -- that was the condition under which it is allowed at all.
    if [ $((now - lease_reminded)) -ge "$REMIND_SECONDS" ]; then
      lease_reminded="$now"; write_lease
      notify "☕ Still simmering, no deadline" \
             "running $(human_duration $((now - lease_started)))" \
             "${lease_reason:-simmer down ends it.}" "Purr"
    fi
  fi
}

############################################################################
### doctor

cmd_doctor() {
  local ok=0 fail=0
  say() { if eval "$2" >/dev/null 2>&1; then echo "✅ $1"; ok=$((ok+1)); else echo "❌ $1"; fail=$((fail+1)); fi; }

  echo "simmer $SIMMER_VERSION"
  echo "==================="
  # The runtime checks, and only those: doctor is the installed binary talking
  # about the running system, so it must work with no repo checked out. The
  # install-time checks (symlink, agent template current) belong to
  # install.sh, which calls this rather than repeating it.
  say "guard loaded ($GUARD_LABEL)"        "launchctl print gui/$(id -u)/$GUARD_LABEL"
  # -nl asks sudo whether the command is *allowed*, without running it and
  # without ever prompting. Testing with `sudo -n pmset -g` would fail even
  # with the rule installed, because -g is deliberately not in the allowlist.
  say "passwordless pmset rule"            "sudo -nl $PMSET -a disablesleep 0"
  say "a notification channel exists"      "[ -d /Applications/SwiftBar.app ] || command -v osascript"
  say "state directory writable"           "[ -w '$STATE' ]"
  say "caffeinate present"                 "command -v caffeinate"
  echo
  echo "State:"
  cmd_status | sed 's/^/  /'
  echo

  if [ "$fail" -gt 0 ]; then
    echo "Anything red above is fixed by re-running the installer:"
    echo "  cd <the simmer repo> && make install"
    echo
    echo "Except the sudo rule, which needs root and is therefore yours to run."
    echo "make install prints the exact command with your username filled in."
    echo
  fi

  # Which channel is about to be used matters more than a generic warning: they
  # fail for completely different reasons.
  if [ -d /Applications/SwiftBar.app ] && pgrep -qx SwiftBar 2>/dev/null; then
    echo "Notifications post through SwiftBar. Firing one now."
  else
    echo "No SwiftBar running, so notifications post as \"Script Editor\". If"
    echo "nothing appears, its alert style is set to none in System Settings --"
    echo "the notification is delivered, just never shown."
  fi
  notify "simmer doctor" "notifications are working" "This banner is the test." "Tink"
  [ "$fail" -gt 0 ] && return 1 || return 0
}

############################################################################
### help
#
# Written out rather than printed from the file header. The header explains *why*
# the tool is built this way, which is what a maintainer needs and exactly what
# someone typing --help does not.

cmd_help() {
  cat <<'HELP'
simmer keeps this Mac awake for a while -- lid closed -- then lets it sleep again.

TRY THIS
  simmer 2h                  stay awake for two hours
  simmer 2h -r "big build"   ...and say what for, so you can see it later
  simmer                     how much longer? what for?
  simmer +30m                need longer: 30 more minutes from now
  simmer down                finished early, let it sleep

HOW LONG
  simmer 45                  45 minutes -- a bare number means minutes
  simmer 90m                 90 minutes
  simmer 2h                  two hours
  simmer 1h30m               an hour and a half
  simmer --until 23:00       until 11pm tonight
  simmer forever             no end time; it reminds you every 30 minutes

IT STOPS BY ITSELF WHEN
  the time runs out  ·  the battery drops below 20%  ·  you run simmer down

  You get a notification five minutes before the end, and another when it stops.
  Even if you close the terminal, log out, or the tool crashes, a background
  watchdog puts the machine back to normal. That is the point of it.

CHANGING THE DEFAULTS
  -r "text"                  what this is for; shown in the menu bar and log
  --min-battery 30           let go under 30% instead of 20%
                             (ignored while plugged in -- charge does not matter then)
  --until 23:00              an absolute time instead of a length
  --owner <name>             who is asking; simmer refuses to overwrite someone
                             else's lease unless you add --force

CHECKING ON IT
  simmer log                 what the watchdog has actually done
  simmer doctor              is everything wired up? fires a test notification
  simmer --version

  Day to day you do not need any of this: the menu bar shows the countdown and
  can extend or release it. See the README for SwiftBar and Raycast setup.

FOR SCRIPTS AND AGENTS
  simmer budget --need 20m   "is there room to start a 20-minute job?"
                               exit 0  yes, or there is no deadline at all
                               exit 1  less than that remains
                               exit 3  nothing is holding the Mac awake
  simmer budget --seconds    just the seconds remaining (-1 = no deadline)
  simmer status --machine    the whole state as key=value lines, for parsing

  See docs/FOR-AGENTS.md for how an agent should use these together.

https://github.com/moralesl/simmer
HELP
}

############################################################################
### Entry point

case "${1:-status}" in
  # `shift` with no arguments returns non-zero, and under `set -e` that ended
  # the script before it printed anything. Bare `simmer` is the most common call
  # there is -- it must not be the one that silently does nothing.
  status)              shift || true; cmd_status "$@" ;;
  --machine)           cmd_status --machine ;;
  --porcelain)         cmd_status --machine ;;   # kept, undocumented
  down|off|stop|release) release "released by hand" ;;
  guard)               cmd_guard ;;
  doctor)              cmd_doctor ;;
  budget)              shift || true; cmd_budget "$@" ;;
  extend)              shift || true; cmd_extend "$@" ;;
  +*)                  cmd_extend "$1" ;;
  log)                 [ -f "$LOG" ] && tail -n "${2:-20}" "$LOG" || echo "no log yet" ;;
  -V|--version)        echo "simmer $SIMMER_VERSION" ;;
  -h|--help|help)      cmd_help ;;
  *)                   cmd_take "$@" ;;
esac
