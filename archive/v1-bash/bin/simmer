#!/bin/bash
# Let the Mac simmer: awake for a bounded time, lid closed, then off by itself.
#
# Why not `caffeinate`: its assertions prevent idle sleep, but not lid sleep. On
# Apple silicon the machine sleeps when you close the lid even with caffeinate
# holding an assertion. Staying awake with the lid shut requires
# `pmset -a disablesleep 1`.
#
# And that is exactly the trap: `disablesleep` is a switch with no way back. It
# survives reboots, nothing on screen indicates it, and whoever forgets it finds
# a flat battery in their bag. (That is precisely what happened here on day one --
# it stayed on for hours.)
#
# So nothing is switched here, it is *borrowed*: every grant has a deadline, and
# it is handed back by `simmer guard` under launchd -- not by memory. Five things
# end awake time and only one of them is remembering:
#
#   1. a claim's deadline passes (or the human's cap clips it)
#   2. the battery drops below that claim's floor, or its charger disappears
#   3. `simmer down`
#   4. thermal pressure -- that one ends everything at once
#   5. the guard finds `disablesleep=1` with no claim behind it (this heals stray
#      pmset runs, including the ones you type yourself)
#
# Awake time is COUNTED, not owned. Everyone -- you, an agent, a build -- holds
# their own claim; the machine stays awake until the latest one ends, and nobody
# can touch anyone else's. That is why there is no `--force` any more: the
# conflict it existed to resolve cannot happen. Above all of them sits the one
# thing only a human sets, the cap: claims ask from below, the cap rules from
# above.
#
#   simmer 60m -r "claude: funnel refactor"  claim 60 minutes
#   simmer 2h --min-battery 30               custom battery floor
#   simmer 2h --require-ac                   ends the moment the charger goes
#   simmer --until 23:00                     absolute time instead of duration
#   simmer forever -r "long run"             no deadline, reminder every 30 min
#   simmer run -- npm test                   claim scoped to the command's lifetime
#   simmer                                   status, with every live claim
#   simmer +20m                              extend YOUR claim
#   simmer down                              hand your claim back now
#   simmer down --all                        hand everything back (humans only)
#   simmer cap 23:00                         nothing past 23:00, whoever asks
#   simmer cap off                           lift it
#   simmer 1h --owner agent                  say who is asking (else: terminal/script)
#   simmer doctor                            guard, sudo rule, notifications
#   simmer --version
#
#   simmer budget                            how much room is left (for agents)
#   simmer budget --need 20m                 exit 0 if it fits, 1 if not, 3 if no claim
#   simmer budget --seconds                  bare seconds left (-1 = no deadline)
#   simmer status --json / budget --json     the same answers as one JSON object
set -euo pipefail

# Where the repo is, resolved through the symlink install.sh puts on PATH, so
# assets (the banner icon) can be found no matter how simmer was invoked.
_self="${BASH_SOURCE[0]}"
while [ -L "$_self" ]; do _self="$(readlink "$_self")"; done
SIMMER_HOME="$(cd "$(dirname "$_self")/.." 2>/dev/null && pwd || echo "")"
ICON="$SIMMER_HOME/assets/icon-256.png"

STATE="${XDG_STATE_HOME:-$HOME/.local/state}/simmer"
CLAIMS="$STATE/claims"
CAP="$STATE/cap"
LEASE="$STATE/lease"          # format=1, read once at migration and then gone
LOG="$STATE/simmer.log"
PMSET=/usr/bin/pmset
SIMMER_VERSION="2.0.0-dev"
GUARD_LABEL=com.github.moralesl.simmer-guard
CLAIM_FORMAT=2

DEFAULT_MIN_BATTERY=20
WARN_SECONDS=300      # a single warning, 5 minutes before the aggregate deadline
REMIND_SECONDS=1800   # with `forever`: remind every 30 minutes
PREFLOOR_MARGIN=10    # warn this many points above a claim's floor

die() { echo "simmer: $*" >&2; exit 1; }

mkdir -p "$CLAIMS"

############################################################################
### The clock
#
# Every reading of "now" goes through here. Nine call sites used to ask `date`
# directly, which made warn-once, the reminder interval and deadline crossings
# testable only by hand-writing timestamps and hoping -- and those are exactly
# the paths a differential run between two implementations has to compare.
# SIMMER_FAKE_NOW pins the clock instead. It is a plain epoch: absolute
# formatting (`date -r`) is unaffected, so only relative arithmetic moves.
now() {
  if [ -n "${SIMMER_FAKE_NOW:-}" ]; then printf '%s' "$SIMMER_FAKE_NOW"
  else date +%s; fi
}

hhmm() { date -r "$1" '+%H:%M'; }

log() { printf '%s  %s\n' "$(date -r "$(now)" '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG"; }

############################################################################
### The claims ledger
#
# One flat key=value file per claim under $STATE/claims/, rather than one lease
# with an owner. The change buys away an entire category of user interface: with
# a single slot, two actors wanting awake time at once forces refusals, `--force`
# and a rule about who may stamp over whom. With counted claims the question
# never arises -- which is also how power management itself works, since
# assertions are counted and not a switch.
#
# A claim's id IS its owner, sanitised into a filename. That is the whole
# ownership model: "extend my claim", "release my claim" and "replace my claim"
# need no registry and cannot be ambiguous, and one actor physically cannot
# address another's file by accident. The cost is that an actor holds at most one
# claim at a time, which is what everyone wants anyway -- `simmer 2h` twice from
# the same terminal should move a deadline, not accumulate two of them. Actors
# that genuinely are several things (`run`) make their own identity unique by
# putting their pid in it, and concurrent agents should namespace themselves the
# same way: `--owner agent:funnel`.
#
# Flat, not JSON, for the same reason as before: the menu bar and the launcher
# scripts read this state, and `jq` should not become a prerequisite for seeing a
# countdown. Written to a temp file and renamed, never edited in place, so the
# guard can never read half a claim and conclude it is corrupt.

c_id=""; c_owner=""; c_until=0; c_started=0; c_reason=""
c_min_battery=$DEFAULT_MIN_BATTERY; c_caffeinate=0; c_require_ac=0
c_warned=0; c_prewarned=0; c_reminded=0

# Anything that is not filename-safe becomes an underscore. The owner is echoed
# back verbatim from inside the file, so the sanitising is invisible in output.
claim_id() { printf '%s' "$1" | tr -c 'A-Za-z0-9._:-' '_'; }
claim_path() { printf '%s/%s' "$CLAIMS" "$(claim_id "$1")"; }

claim_reset() {
  c_id=""; c_owner=""; c_until=0; c_started=0; c_reason=""
  c_min_battery=$DEFAULT_MIN_BATTERY; c_caffeinate=0; c_require_ac=0
  c_warned=0; c_prewarned=0; c_reminded=0
}

claim_read() { # <file>
  [ -f "$1" ] || return 1
  claim_reset
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      id)           c_id="$value" ;;
      owner)        c_owner="$value" ;;
      until)        c_until="$value" ;;
      started)      c_started="$value" ;;
      reason)       c_reason="$value" ;;
      min_battery)  c_min_battery="$value" ;;
      caffeinate)   c_caffeinate="$value" ;;
      require_ac)   c_require_ac="$value" ;;
      warned)       c_warned="$value" ;;
      prewarned)    c_prewarned="$value" ;;
      reminded)     c_reminded="$value" ;;
    esac
  done < "$1"
  [ -n "$c_id" ] || c_id="$(basename "$1")"
  [ -n "$c_owner" ] || c_owner="$c_id"
  return 0
}

claim_write() { # <file>
  local tmp="$1.$$"
  {
    # A format number so a later change is detectable instead of being read as
    # garbage by whichever binary happens to be installed. 2 is the ledger.
    echo "format=$CLAIM_FORMAT"
    echo "id=$c_id"
    echo "owner=$c_owner"
    echo "until=$c_until"
    echo "started=$c_started"
    echo "reason=$c_reason"
    echo "min_battery=$c_min_battery"
    echo "caffeinate=$c_caffeinate"
    echo "require_ac=$c_require_ac"
    echo "warned=$c_warned"
    echo "prewarned=$c_prewarned"
    echo "reminded=$c_reminded"
  } > "$tmp"
  mv -f "$tmp" "$1"
}

# Glob order, which is alphabetical and therefore stable -- ties in the
# aggregate below resolve the same way on every run and in every implementation.
claim_files() {
  local f
  for f in "$CLAIMS"/*; do [ -f "$f" ] && printf '%s\n' "$f"; done
  return 0
}

claim_count() { claim_files | wc -l | tr -d ' '; }

############################################################################
### The cap -- the one ceiling only a human sets
#
# Claims request awake time from below; the cap rules from above. `simmer cap
# 23:00` clips every claim, the ones already held and the ones taken later, and
# an agent that runs into it gets a truthful budget answer rather than an error
# to route around.
#
# A cap whose time has passed keeps refusing new claims until a human moves or
# lifts it. Letting it expire quietly would be the friendlier behaviour and the
# wrong one: it would throw away a decision a person made on purpose, which is
# the exact failure this tool exists to prevent. Every surface says the cap is
# there and how to lift it, so it is a visible gate rather than a trap.

cap_until=0; cap_set_by=""; cap_set_at=0

cap_read() {
  cap_until=0; cap_set_by=""; cap_set_at=0
  [ -f "$CAP" ] || return 1
  local key value
  while IFS='=' read -r key value; do
    case "$key" in
      until)  cap_until="$value" ;;
      set_by) cap_set_by="$value" ;;
      set_at) cap_set_at="$value" ;;
    esac
  done < "$CAP"
  [ "$cap_until" != 0 ]
}

cap_write() { # <epoch> <who>
  local tmp="$CAP.$$"
  { echo "format=$CLAIM_FORMAT"; echo "until=$1"; echo "set_by=$2"; echo "set_at=$(now)"; } > "$tmp"
  mv -f "$tmp" "$CAP"
}

# A claim's deadline as the machine will actually honour it. No deadline plus a
# cap is a deadline; a deadline past the cap is the cap.
capped_until() { # <claim until> -> effective epoch (0 = genuinely open-ended)
  local u="$1"
  cap_read || { printf '%s' "$u"; return 0; }
  if [ "$u" = 0 ] || [ "$u" -gt "$cap_until" ]; then printf '%s' "$cap_until"
  else printf '%s' "$u"; fi
}

############################################################################
### Migration from the single lease (format=1)
#
# Read once, then gone. Someone upgrading mid-lease must not silently lose the
# awake time they are relying on -- and must not end up with both shapes on
# disk, which is how a guard learns to disagree with the CLI.
migrate_lease() {
  [ -f "$LEASE" ] || return 0
  claim_reset
  local key value owner=""
  while IFS='=' read -r key value; do
    case "$key" in
      until)       c_until="$value" ;;
      started)     c_started="$value" ;;
      reason)      c_reason="$value" ;;
      min_battery) c_min_battery="$value" ;;
      caffeinate)  c_caffeinate="$value" ;;
      warned)      c_warned="$value" ;;
      reminded)    c_reminded="$value" ;;
      owner)       owner="$value" ;;
    esac
  done < "$LEASE"
  [ -n "$owner" ] || owner="legacy"
  c_owner="$owner"; c_id="$(claim_id "$owner")"
  local f; f="$(claim_path "$owner")"
  [ -e "$f" ] && { c_id="legacy"; c_owner="legacy"; f="$CLAIMS/legacy"; }
  claim_write "$f"
  rm -f "$LEASE"
  log "migrated a format=1 lease into claim $c_id"
}

migrate_lease

############################################################################
### The aggregate -- what the machine will actually do
#
# Every surface answers from this and never from a single claim, because the
# question a human asks the menu bar is "when does my Mac sleep", not "whose
# claim is this". The descriptive fields (reason, owner, floor, since) come from
# the claim that DEFINES the aggregate deadline -- one coherent rule, and
# identical to the old single-lease answer whenever there is one claim, which
# keeps every existing assertion meaning what it meant.

A_STATE=idle; A_UNTIL=0; A_LEFT=0; A_COUNT=0
A_REASON=""; A_OWNER=""; A_MIN_BATTERY=$DEFAULT_MIN_BATTERY; A_SINCE=0
A_CAP=0; A_CAPPED=0; A_LEFT_SHORT=""; A_FILE=""

aggregate() {
  local n; n="$(now)"
  A_STATE=idle; A_UNTIL=0; A_LEFT=0; A_COUNT=0
  A_REASON=""; A_OWNER=""; A_MIN_BATTERY=$DEFAULT_MIN_BATTERY; A_SINCE=0
  A_CAP=0; A_CAPPED=0; A_LEFT_SHORT=""; A_FILE=""
  cap_read && A_CAP="$cap_until"

  local f eff best_file="" best=0 forever_file="" have=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    claim_read "$f" || continue
    eff="$(capped_until "$c_until")"
    # Already over: the guard will retire it on its next tick. It must not be
    # counted meanwhile, or status would promise time that has gone.
    [ "$eff" != 0 ] && [ "$eff" -le "$n" ] && continue
    have=1; A_COUNT=$((A_COUNT + 1))
    if [ "$eff" = 0 ]; then
      [ -z "$forever_file" ] && forever_file="$f"
    elif [ "$eff" -gt "$best" ]; then
      best="$eff"; best_file="$f"
    fi
  done <<EOF
$(claim_files)
EOF

  if [ "$have" = 0 ]; then
    sleep_disabled && A_STATE=orphan || A_STATE=idle
    return 0
  fi

  # An open-ended claim wins only if nothing caps it -- with a cap in force the
  # machine has a real deadline, and saying "forever" would be a lie.
  local def
  if [ -n "$forever_file" ]; then
    A_STATE=forever; A_UNTIL=0; A_LEFT=0; A_LEFT_SHORT="∞"; def="$forever_file"
  else
    A_STATE=active; A_UNTIL="$best"; A_LEFT=$((best - n))
    A_LEFT_SHORT="$(short_duration "$A_LEFT")"; def="$best_file"
  fi
  A_FILE="$def"
  claim_read "$def"
  A_REASON="$c_reason"; A_OWNER="$c_owner"
  A_MIN_BATTERY="$c_min_battery"; A_SINCE="$c_started"
  [ "$A_CAP" != 0 ] && [ "$A_UNTIL" = "$A_CAP" ] && A_CAPPED=1
  return 0
}

############################################################################
### System state

# The three readings and the one write, funnelled through four functions so the
# test suite can substitute them. Without this seam a test of the guard has to
# flip real disablesleep -- which needs sudo, changes the machine under you, and
# makes the battery branch untestable while charging. SIMMER_FAKE_* is read only
# here and documented in ARCHITECTURE.md.
sleep_disabled() {
  if [ -n "${SIMMER_FAKE_PMSET:-}" ]; then
    [ "$(cat "$SIMMER_FAKE_PMSET" 2>/dev/null || echo 0)" = 1 ]
  else
    $PMSET -g live 2>/dev/null | grep -q 'SleepDisabled[[:space:]]*1'
  fi
}

battery_percent() {
  if [ -n "${SIMMER_FAKE_BATTERY:-}" ]; then printf '%s' "${SIMMER_FAKE_BATTERY%%:*}"
  else $PMSET -g batt | grep -oE '[0-9]+%' | head -1 | tr -d '%'; fi
}

on_battery() {
  if [ -n "${SIMMER_FAKE_BATTERY:-}" ]; then [ "${SIMMER_FAKE_BATTERY##*:}" = 1 ]
  else $PMSET -g batt | grep -q "'Battery Power'"; fi
}

battery_line() {
  local pct; pct="$(battery_percent)"
  if on_battery; then echo "battery ${pct}%"; else echo "on AC, battery ${pct}%"; fi
}

# How long the screen stays UNLOCKED after the lid closes. simmer is the tool
# that turns a lax "require password" setting into a running, unlocked laptop in
# a bag -- which obliges it to say so. sysadminctl needs no root; it reports to
# stderr, and "immediate"/"off" carry no number.
lock_delay_seconds() {
  if [ -n "${SIMMER_FAKE_LOCKDELAY:-}" ]; then printf '%s' "$SIMMER_FAKE_LOCKDELAY"; return; fi
  local out; out="$(sysadminctl -screenLock status 2>&1)"
  case "$out" in
    *immediate*) printf '0' ;;
    *) printf '%s' "$out" | grep -oE '[0-9]+ second' | grep -oE '[0-9]+' | head -1 ;;
  esac
}

# Thermal pressure. Nominal reads as "No thermal warning level has been
# recorded"; under pressure macOS reports "Thermal Warning Level = N". A hot
# machine with the lid closed is the one state this tool can create and the
# user cannot notice, so the guard treats any warning level like a low battery:
# release, notify, let it cool. Heat is the one condition that ends every claim
# at once -- it is a property of the machine, not of anybody's plan for it.
thermal_pressure() {
  if [ -n "${SIMMER_FAKE_THERMAL:-}" ]; then [ "$SIMMER_FAKE_THERMAL" -gt 0 ]; return; fi
  $PMSET -g therm 2>/dev/null | grep -qiE 'thermal warning level *[=:] *[1-9]'
}

# Flipping the switch needs root. The guard runs unattended and must therefore
# *never* ask for a password -- `sudo -n` or nothing. Interactively a prompt is
# fine; without the sudo rule from sudoers.d/simmer it would appear on every claim.
set_disablesleep() { # <0|1>
  if [ -n "${SIMMER_FAKE_PMSET:-}" ]; then printf '%s' "$1" > "$SIMMER_FAKE_PMSET"; return 0; fi
  sudo -n $PMSET -a disablesleep "$1" 2>/dev/null && return 0
  [ "${SIMMER_NONINTERACTIVE:-0}" = 1 ] && return 1
  [ -t 0 ] || return 1
  echo "simmer: needs sudo once (to stop being asked: simmer doctor)" >&2
  sudo $PMSET -a disablesleep "$1"
}

############################################################################
### Feedback
#
# Three lines rather than two: title says which state, subtitle the number that
# matters, body the reason -- omitted entirely when there is none.
#
# The transport is a setting, not a guess. Four attempts at "the one that works"
# each turned out to fail differently on macOS 26, so the choice is now explicit
# and testable: `simmer notify-test` fires one through every transport at once,
# and whichever appears is the one to set.
#
#   SIMMER_NOTIFY=auto       bundle, else shortcut, else swiftbar, else osascript
#   SIMMER_NOTIFY=bundle     simmer's own app: OUR name, OUR icon. Built from
#                            notifier/main.swift by install.sh -- an installed,
#                            ad-hoc-signed bundle owns its identity after one
#                            Allow click. Recipe and traps: docs/V2-BRIEF.md.
#   SIMMER_NOTIFY=shortcut   the Shortcuts app -- first-party and signed, so its
#                            notifications display. Needs a shortcut named
#                            "simmer-notify" that shows its input. Icon: Shortcuts.
#   SIMMER_NOTIFY=swiftbar   SwiftBar's URL scheme. Known to display. Icon: SwiftBar.
#   SIMMER_NOTIFY=osascript  posts as Script Editor. Often delivered, not shown.
#   SIMMER_NOTIFY=say        spoken aloud. Unmissable, no notification system at all.
#   SIMMER_NOTIFY=none       silence; rely on the menu bar, which cannot be suppressed.
NOTIFY_SHORTCUT="${SIMMER_NOTIFY_SHORTCUT:-simmer-notify}"
# Overridable for tests; the executable path doubles as the existence check.
NOTIFIER_APP="${SIMMER_NOTIFIER_APP:-$HOME/Applications/Simmer.app}"
NOTIFIER_BIN="$NOTIFIER_APP/Contents/MacOS/simmer-notify"

notify() { # <title> <subtitle> <body> [system sound]
  local title="$1" subtitle="$2" body="$3" how="${SIMMER_NOTIFY:-auto}"

  if [ "$how" = auto ]; then
    if [ -x "$NOTIFIER_BIN" ]; then how=bundle
    elif shortcuts list 2>/dev/null | grep -qxF "$NOTIFY_SHORTCUT"; then how=shortcut
    elif [ -d /Applications/SwiftBar.app ] && pgrep -qx SwiftBar 2>/dev/null; then how=swiftbar
    else how=osascript; fi
  fi

  case "$how" in
    bundle)    notify_via_bundle    "$title" "$subtitle" "$body" ;;
    shortcut)  notify_via_shortcut  "$title" "$subtitle" "$body" ;;
    swiftbar)  notify_via_swiftbar  "$title" "$subtitle" "$body" ;;
    osascript) notify_via_osascript "$title" "$subtitle" "$body" ;;
    say)       (say -v Daniel "${title//[^a-zA-Z0-9 ]/ }" >/dev/null 2>&1 &) ;;
    none)      : ;;
    *)         notify_via_osascript "$title" "$subtitle" "$body" ;;
  esac

  # Not decoration: the sound carries when a banner does not, and the menu bar is
  # the indicator nothing can suppress.
  [ -n "${4:-}" ] && [ -f "/System/Library/Sounds/$4.aiff" ] &&
    (afplay -v 0.5 "/System/Library/Sounds/$4.aiff" >/dev/null 2>&1 &)
  return 0
}

# The preferred channel: simmer's own bundle, so the banner carries simmer's
# name and the pot icon. Non-zero means not (or not yet) authorized -- fall back
# so THIS message still lands somewhere; the permission banner the binary just
# triggered sorts out the next one.
notify_via_bundle() { # <title> <subtitle> <body>
  "$NOTIFIER_BIN" "$1" "$2" "$3" >/dev/null 2>&1 || notify_via_osascript "$1" "$2" "$3"
}

# Shortcuts reads its input from a file, which is the pattern already in use here.
notify_via_shortcut() { # <title> <subtitle> <body>
  local f="$STATE/notify"
  { printf '%s' "$1"; [ -n "$2" ] && printf ' — %s' "$2"; [ -n "$3" ] && printf '\n%s' "$3"; echo; } > "$f"
  shortcuts run "$NOTIFY_SHORTCUT" -i "$f" >/dev/null 2>&1 ||
    notify_via_osascript "$1" "$2" "$3"
}

notify_via_swiftbar() { # <title> <subtitle> <body>
  local q
  q="title=$(urlencode "$1")&subtitle=$(urlencode "$2")&body=$(urlencode "$3")"
  open -g "swiftbar://notify?plugin=simmer&$q&silent=true" >/dev/null 2>&1 ||
    notify_via_osascript "$1" "$2" "$3"
}

# Byte-wise under LC_ALL=C so multi-byte characters survive instead of being
# mangled one byte at a time.
urlencode() {
  local LC_ALL=C str="$1" out="" i c
  for (( i=0; i<${#str}; i++ )); do
    c="${str:i:1}"
    case "$c" in
      [a-zA-Z0-9.~_-]) out="$out$c" ;;
      *) out="$out$(printf '%%%02X' "'$c")" ;;
    esac
  done
  printf '%s' "$out"
}

# One banner per transport, labelled. Whichever one you actually see is the answer,
# and it replaces another round of me guessing which API macOS still honours.
cmd_notify_test() {
  echo "Firing one notification through each transport."
  echo "Whichever you SEE is the one that works. Then set it, e.g.:"
  echo "  echo 'export SIMMER_NOTIFY=shortcut' >> ~/.zshrc"
  echo
  local t
  for t in bundle shortcut swiftbar osascript; do
    printf '  %-10s ' "$t"
    case "$t" in
      bundle)
        if [ -x "$NOTIFIER_BIN" ]; then
          notify_via_bundle "simmer via $t" "transport test" "the pot icon means use $t"
          echo "sent (status: $("$NOTIFIER_BIN" --status 2>/dev/null))"
        else echo "skipped -- not built (make install, needs swiftc)"; fi ;;
      shortcut)
        if shortcuts list 2>/dev/null | grep -qxF "$NOTIFY_SHORTCUT"; then
          notify_via_shortcut "simmer via $t" "transport test" "if you see this, use $t"
          echo "sent"
        else
          echo "skipped -- no shortcut named \"$NOTIFY_SHORTCUT\" (see README)"
        fi ;;
      swiftbar)
        if pgrep -qx SwiftBar 2>/dev/null; then
          notify_via_swiftbar "simmer via $t" "transport test" "if you see this, use $t"
          echo "sent"
        else echo "skipped -- SwiftBar not running"; fi ;;
      osascript)
        notify_via_osascript "simmer via $t" "transport test" "if you see this, use $t"
        echo "sent" ;;
    esac
  done
  echo
  echo "Nothing at all? The menu bar always shows the truth and cannot be"
  echo "suppressed -- SIMMER_NOTIFY=none is a legitimate choice."
}

notify_via_osascript() { # <title> <subtitle> <body>
  local title="${1//\"/\\\"}" subtitle="${2//\"/\\\"}" body="${3//\"/\\\"}"
  local script="display notification \"$body\" with title \"$title\""
  [ -n "$subtitle" ] && script="$script subtitle \"$subtitle\""
  osascript -e "$script" 2>/dev/null || true
}

# The menu bar polls its own state every 10 seconds; this is only for the
# immediate feel right after a command. If SwiftBar is absent it costs nothing.
refresh_menubar() {
  [ -d /Applications/SwiftBar.app ] || return 0
  open -g "swiftbar://refreshplugin?name=simmer" >/dev/null 2>&1 || true
  return 0
}

############################################################################
### Who is asking, and whether they are a person
#
# The owner used to exist so simmer could refuse to stamp over someone else's
# lease. Claims made that refusal unnecessary, and gave the owner a bigger job:
# it is the claim's identity, the name in the menu bar, and the thing that
# decides who may release what.
#
# Launchers export SIMMER_OWNER; a terminal is recognised by its tty; anything
# else is a script, which is also what an agent looks like unless it says
# otherwise. Agents should export SIMMER_OWNER=agent -- and namespace themselves
# (`agent:funnel`) when several of them run at once, so each gets its own claim.
current_owner() {
  if [ -n "${SIMMER_OWNER:-}" ]; then printf '%s' "$SIMMER_OWNER"
  elif [ -t 0 ]; then printf 'terminal'
  else printf 'script'; fi
}

# Human primacy, mechanically: a person may release ANY claim, an agent only its
# own. The surfaces a person drives (terminal, menu bar, launchers) carry that
# authority; `--owner agent` does not.
#
# This is a convention enforced against honest actors, not a security boundary --
# nothing stops a process from passing `--owner terminal`, and on a single-user
# Mac nothing could. What it does buy is that an agent following the protocol
# cannot take a human's time away by accident, which is the failure that actually
# happens. docs/FOR-AGENTS.md states the obligation not to claim human authority.
caller_is_human() {
  [ "${SIMMER_HUMAN:-0}" = 1 ] && return 0
  owner_is_human_name "$(current_owner)"
}

# Named rather than inlined into the JSON: a `case` inside $( ) has its pattern's
# closing paren read as the end of the substitution by bash 3.2.
owner_is_human_name() { # <owner>
  case "$1" in terminal|menubar|raycast|alfred) return 0 ;; esac
  return 1
}

owner_glyph() { # <owner>
  case "$1" in
    run:*|run)                        printf '⚙' ;;
    terminal|menubar|raycast|alfred)  printf '👤' ;;
    *)                                printf '🤖' ;;
  esac
}

############################################################################
### Durations and times

# 90 | 90m | 1h | 1h30m | 45min | 2h15
parse_duration() { # <text> -> seconds
  # tr rather than ${1,,}: the shebang is /bin/bash, which on macOS is still
  # 3.2, and lowercasing expansions arrived in bash 4. Staying on /bin/bash is
  # deliberate -- a launchd job should not depend on a Homebrew shell.
  local text total=0 rest
  text="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
  rest="$text"
  [[ "$text" =~ ^[0-9]+$ ]] && { echo $((text * 60)); return 0; }
  local matched=0
  while [[ "$rest" =~ ^([0-9]+)(h|hours?|m|min|minutes?|s|sec|seconds?)(.*)$ ]]; do
    local n="${BASH_REMATCH[1]}" unit="${BASH_REMATCH[2]}"
    rest="${BASH_REMATCH[3]}"
    case "$unit" in
      h|hour|hours) total=$((total + n * 3600)) ;;
      s|sec|second|seconds) total=$((total + n)) ;;
      *) total=$((total + n * 60)) ;;
    esac
    matched=1
  done
  # "2h15" -- a trailing bare number means minutes
  [[ "$rest" =~ ^[0-9]+$ ]] && { total=$((total + rest * 60)); rest=""; }
  [ "$matched" = 1 ] && [ -z "$rest" ] && [ "$total" -gt 0 ] && { echo "$total"; return 0; }
  return 1
}

# HH:MM -> epoch. If the time is already behind us, tomorrow is meant.
parse_until() { # <HH:MM> -> epoch
  [[ "$1" =~ ^([0-9]{1,2}):([0-9]{2})$ ]] || return 1
  local n; n="$(now)"
  local target; target="$(date -j -f '%Y-%m-%d %H:%M' "$(date -r "$n" '+%Y-%m-%d') $1" '+%s' 2>/dev/null)" || return 1
  [ "$target" -le "$n" ] && target=$((target + 86400))
  echo "$target"
}

human_duration() { # <seconds> -> "1 h 20 min"
  local s="$1"
  [ "$s" -lt 0 ] && s=0
  local h=$((s / 3600)) m=$(((s % 3600) / 60))
  if [ "$h" -gt 0 ]; then echo "${h} h ${m} min"
  elif [ "$m" -gt 0 ]; then echo "${m} min"
  else echo "under 1 min"; fi
}

short_duration() { # <seconds> -> "1h20" / "42m" -- for the menu bar
  local s="$1"
  [ "$s" -lt 0 ] && s=0
  local h=$((s / 3600)) m=$(((s % 3600) / 60))
  if [ "$h" -gt 0 ]; then printf '%dh%02d\n' "$h" "$m"
  else printf '%dm\n' "$m"; fi
}

############################################################################
### Taking, retiring and settling
#
# `settle` is the ONLY place that decides whether the switch stays on, and every
# mutation ends there. That is what turns contract guarantee 2 -- "no code path
# leaves disablesleep on without something scheduled to turn it off" -- from a
# promise into a property: a claim can be added or retired anywhere, and the one
# function that reads the aggregate afterwards puts the switch where the ledger
# says it belongs.

retire_claim() { # <file> <why>
  claim_read "$1" || return 1
  [ "$c_caffeinate" != 0 ] && kill "$c_caffeinate" 2>/dev/null || true
  rm -f "$1"
  log "retired ${c_owner}${c_reason:+ ($c_reason)} · $2"
  return 0
}

# Off, and said out loud. The failure branch matters more than the success one:
# without the sudo rule the machine simply stays awake, and that must never be
# quiet.
switch_back() { # <why> [sound]
  local why="$1" sound="${2:-Blow}"
  if set_disablesleep 0; then
    log "sleep allowed again ($why)"
    notify "⏾ Sleep allowed again" "$why" "" "$sound"
    return 0
  fi
  log "ERROR: could not revert disablesleep ($why)"
  notify "⚠️ simmer could not release" "disablesleep is still on" \
         "Run 'simmer doctor' in a terminal." "Basso"
  return 1
}

# After any change to the ledger: the switch follows the aggregate, and the human
# hears about the aggregate only when it actually moved. Per-claim churn that
# leaves the machine's promise unchanged stays silent -- notification spam is how
# a tool trains people to ignore it.
settle() { # <why> [sound]
  local why="$1" sound="${2:-Blow}" rc=0
  aggregate
  if [ "$A_COUNT" = 0 ]; then
    if sleep_disabled; then switch_back "$why" "$sound" || rc=1; fi
  else
    if ! sleep_disabled; then
      if set_disablesleep 1; then log "restored disablesleep with $A_COUNT claim(s) live"
      else log "ERROR: could not set disablesleep with $A_COUNT claim(s) live"; rc=1; fi
    fi
  fi
  refresh_menubar
  return $rc
}

# The second, independent clock. caffeinate cannot hold the lid, but it expires
# on its own via -t, so if the guard ever dies that timer still fires.
#
# nohup, because otherwise closing the terminal that started the claim sends
# SIGHUP to this background child and the second clock quietly disappears.
#
# -ims by default, NOT -dims: the display is allowed to sleep. You took a claim
# because you are walking away, so holding a screen lit serves nobody and costs
# exactly the battery the floor exists to protect. With the lid shut it is off
# regardless. `--display-on` adds -d back for the demo and kiosk cases.
#
# No -u in either: it asserts *user activity* and, given no -t, lasts five
# seconds -- an assertion in name only.
start_caffeinate() { # <until epoch, 0 = none> <display 0|1> -> pid
  local flags=-ims
  [ "$2" = 1 ] && flags=-dims
  if [ "$1" != 0 ]; then
    nohup caffeinate "$flags" -t $(($1 - $(now))) >/dev/null 2>&1 &
  else
    nohup caffeinate "$flags" >/dev/null 2>&1 &
  fi
  printf '%s' "$!"
}

cmd_take() {
  local seconds=0 until_epoch=0 reason="" min_battery=$DEFAULT_MIN_BATTERY
  local forever=0 display=0 require_ac=0
  while [ $# -gt 0 ]; do
    case "$1" in
      -r|--reason)      reason="${2:-}"; shift 2 ;;
      --min-battery)    min_battery="${2:-}"; shift 2 ;;
      --until)          until_epoch="$(parse_until "${2:-}")" || die "did not understand the time: ${2:-} (expected HH:MM)"; shift 2 ;;
      forever|--forever|--indefinite) forever=1; shift ;;
      --require-ac)     require_ac=1; shift ;;
      --display-on)     display=1; shift ;;
      # Accepted and ignored. It used to mean "stamp over someone else's lease";
      # claims removed the conflict it resolved, so there is nothing left for it
      # to do. Kept rather than removed because launcher shims and other
      # people's scripts pass it, and erroring on a flag that has become
      # harmless would break callers for no gain -- but it says so, because a
      # silent no-op would hide the model change from whoever typed it.
      -f|--force)       echo "simmer: --force no longer does anything -- claims cannot collide" >&2; shift ;;
      # A flag as well as SIMMER_OWNER, because SwiftBar can pass arguments to a
      # menu action but cannot set environment variables for it.
      --owner)          SIMMER_OWNER="${2:-}"; shift 2 ;;
      -*)               die "unknown option: $1" ;;
      *)                seconds="$(parse_duration "$1")" || die "did not understand the duration: $1 (e.g. 60m, 2h, 1h30m)"; shift ;;
    esac
  done

  [[ "$min_battery" =~ ^[0-9]+$ ]] || die "--min-battery expects a number"

  local n; n="$(now)"
  if [ "$forever" = 1 ]; then
    until_epoch=0
  elif [ "$until_epoch" = 0 ]; then
    [ "$seconds" -gt 0 ] || die "no duration given. 'simmer 60m', 'simmer --until 23:00' or 'simmer forever'"
    until_epoch=$((n + seconds))
  fi

  # Check the floor before flipping the switch: a claim the guard reclaims on its
  # very next tick is only confusing.
  local pct; pct="$(battery_percent)"
  if on_battery && [ "$pct" -le "$min_battery" ]; then
    notify "⚠️ simmer refused" "Battery ${pct}%, floor ${min_battery}%" \
           "Plug in, or lower --min-battery." "Basso"
    die "battery ${pct}% <= floor ${min_battery}%. Plug in, or lower --min-battery."
  fi
  # Same argument for --require-ac: asking for a claim that ends the moment it
  # starts is never what was meant.
  if [ "$require_ac" = 1 ] && on_battery; then
    die "--require-ac, and this Mac is on battery. Plug in first."
  fi

  # The cap clips from above, and it clips silently only when it makes the claim
  # shorter. When it makes the claim impossible, that is worth a refusal: the
  # honest answer to "give me two hours" past a human's ceiling is no, plus who
  # to ask.
  local capped=0
  if cap_read; then
    if [ "$cap_until" -le "$n" ]; then
      die "the cap is $(hhmm "$cap_until"), which has passed. A human lifts it with 'simmer cap off'."
    fi
    if [ "$until_epoch" = 0 ] || [ "$until_epoch" -gt "$cap_until" ]; then
      until_epoch="$cap_until"; capped=1
    fi
  fi

  local owner; owner="$(current_owner)"
  local file; file="$(claim_path "$owner")"

  # Replacing your OWN claim is ordinary and stays silent -- that is what a
  # second `simmer 2h` from the same terminal means. Nobody else's claim is even
  # addressable from here.
  local started="$n"
  if claim_read "$file"; then
    [ "$c_caffeinate" != 0 ] && kill "$c_caffeinate" 2>/dev/null || true
    started="$c_started"
  fi

  aggregate; local was_state="$A_STATE" was_until="$A_UNTIL"

  set_disablesleep 1 || die "could not set disablesleep (sudo?). Run 'simmer doctor'"

  claim_reset
  c_id="$(claim_id "$owner")"; c_owner="$owner"
  c_until="$until_epoch"; c_started="$started"; c_reason="$reason"
  c_min_battery="$min_battery"; c_require_ac="$require_ac"
  c_caffeinate="$(start_caffeinate "$until_epoch" "$display")"
  c_warned=0; c_prewarned=0; c_reminded="$n"
  claim_write "$file"

  aggregate

  # Report YOUR claim first -- it is what you asked for. The aggregate is a
  # separate fact and only worth a line when it differs, which is exactly when
  # the reader would otherwise be misled about when the machine sleeps.
  if [ "$until_epoch" = 0 ]; then
    log "claim $owner: no deadline${reason:+ ($reason)}, battery floor ${min_battery}%"
    echo "☕ simmering, no deadline${reason:+ · $reason}"
    echo "   reminder every 30 min · releases below ${min_battery}% battery · 'simmer down' ends it"
  else
    log "claim $owner: until $(hhmm "$until_epoch")${reason:+ ($reason)}, battery floor ${min_battery}%"
    echo "☕ simmering until $(hhmm "$until_epoch") ($(human_duration $((until_epoch - n))))${reason:+ · $reason}"
    echo "   lid may close · $(battery_line) · releases below ${min_battery}%"
    [ "$capped" = 1 ] && echo "   clipped by the cap at $(hhmm "$cap_until")"
    [ "$require_ac" = 1 ] && echo "   ends if the charger is unplugged"
    local delay; delay="$(lock_delay_seconds)"
    [ -n "$delay" ] && [ "$delay" -gt 60 ] 2>/dev/null &&
      echo "   note: the screen stays UNLOCKED ${delay}s after the lid closes (System Settings > Lock Screen)"
  fi
  if [ "$A_COUNT" -gt 1 ]; then
    echo "   $A_COUNT claims live · the Mac stays awake until $([ "$A_UNTIL" = 0 ] && echo "further notice" || hhmm "$A_UNTIL") · 'simmer status' lists them"
  fi

  # Only when the machine's promise actually changed. Someone taking a claim
  # inside a longer one already awake has changed nothing a human needs told.
  if [ "$A_STATE" != "$was_state" ] || [ "$A_UNTIL" != "$was_until" ]; then
    if [ "$A_UNTIL" = 0 ]; then
      notify "☕ Simmering, no deadline" "reminder every 30 min · floor ${min_battery}%" \
             "${reason:-Ends with simmer down.}" "Submarine"
    else
      notify "☕ Simmering until $(hhmm "$A_UNTIL")" \
             "$(human_duration $((A_UNTIL - n))) · lid may close" "${reason:-}" "Submarine"
    fi
  fi
  refresh_menubar
}

cmd_extend() {
  local arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) SIMMER_OWNER="${2:-}"; shift 2 ;;
      *)       arg="$1"; shift ;;
    esac
  done
  arg="${arg#+}"
  [ -n "$arg" ] || die "extend by how much? 'simmer +20m'"
  local seconds; seconds="$(parse_duration "$arg")" || die "did not understand the duration: $arg"

  local owner; owner="$(current_owner)"
  local file; file="$(claim_path "$owner")"
  claim_read "$file" || die "no claim of yours to extend. 'simmer ${arg}' takes one."
  [ "$c_until" = 0 ] && die "your claim has no deadline -- there is nothing to extend."

  # From now, not from the old deadline: after "+20m" twenty minutes should be
  # left, not twenty plus whatever remained.
  local n; n="$(now)"
  local target=$((n + seconds))
  if cap_read; then
    [ "$cap_until" -le "$n" ] && die "the cap is $(hhmm "$cap_until"), which has passed. A human lifts it with 'simmer cap off'."
    if [ "$target" -gt "$cap_until" ]; then
      [ "$c_until" -ge "$cap_until" ] && die "already at the cap ($(hhmm "$cap_until")). Only a human can move it."
      target="$cap_until"
    fi
  fi

  aggregate; local was_until="$A_UNTIL" was_state="$A_STATE"
  c_until="$target"; c_warned=0
  claim_write "$file"
  aggregate

  log "extended $owner until $(hhmm "$target")"
  echo "☕ simmering until $(hhmm "$target") ($(human_duration $((target - n))))"
  [ "$target" != $((n + seconds)) ] && echo "   clipped by the cap at $(hhmm "$cap_until")"
  # Your deadline moved; the machine's may not have. Saying so is the difference
  # between "30 more minutes" and "30 more minutes, and then it still will not
  # sleep because somebody else is holding it open-ended".
  if [ "$A_UNTIL" = 0 ]; then
    echo "   the machine stays awake until further notice — another claim has no deadline"
  elif [ "$A_UNTIL" != "$target" ]; then
    echo "   the machine stays awake until $(hhmm "$A_UNTIL") — another claim reaches further"
  fi
  if [ "$A_STATE" != "$was_state" ] || [ "$A_UNTIL" != "$was_until" ]; then
    # The banner describes the AGGREGATE, which can be open-ended even though the
    # claim just extended is not -- somebody else may hold a claim with no
    # deadline. Formatting epoch 0 as a time would say "01:00".
    if [ "$A_UNTIL" = 0 ]; then
      notify "☕ Extended" "still no deadline overall" "${c_reason:-}" "Pop"
    else
      notify "☕ Extended until $(hhmm "$A_UNTIL")" "$(human_duration $((A_UNTIL - n))) left" \
             "${c_reason:-}" "Pop"
    fi
  fi
  refresh_menubar
}

############################################################################
### Handing it back

# Bare `simmer down` releases YOUR claims. The interesting case is a person with
# no claim of their own -- claims held only by agents and builds -- because
# `simmer down` from a human means "let my Mac sleep" and always has. So it
# releases everything, and names what it released: human primacy says a person
# may end any claim, and honesty says they should be told whose. An agent in the
# same position is refused and shown the list, because ending someone else's work
# is not an agent's call.
cmd_down() {
  local all=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --all)        all=1; shift ;;
      --owner)      SIMMER_OWNER="${2:-}"; shift 2 ;;
      # Accepted and ignored: launchers append a reason to every action they
      # emit, and there is nothing for a release to record it against.
      -r|--reason)  shift 2 ;;
      *)            die "usage: simmer down [--all]" ;;
    esac
  done

  local owner; owner="$(current_owner)"
  local mine; mine="$(claim_path "$owner")"
  local total; total="$(claim_count)"

  # Nothing claimed, switch on: the orphan. Reverting it is always allowed, by
  # anyone -- stopping is never the thing simmer stands in the way of.
  if [ "$total" = 0 ]; then
    if sleep_disabled; then switch_back "reverted by hand" "Blow" || exit 1
    else echo "⏾ nothing to release · sleep is already allowed"; fi
    refresh_menubar
    return 0
  fi

  if [ "$all" = 1 ] && ! caller_is_human; then
    echo "simmer: 'down --all' ends claims that are not yours -- only a person may do that." >&2
    list_claims_indented >&2
    die "release your own with 'simmer down', or ask the human"
  fi

  if [ "$all" = 1 ]; then
    local f
    while IFS= read -r f; do
      [ -n "$f" ] && retire_claim "$f" "released by hand (all)"
    done <<EOF
$(claim_files)
EOF
    echo "⏾ released all $total claim(s)"
    settle "released by hand" "Blow" || exit 1
    return 0
  fi

  if [ -f "$mine" ]; then
    claim_read "$mine"
    retire_claim "$mine" "released by hand"
    aggregate
    if [ "$A_COUNT" = 0 ]; then echo "⏾ released"
    else
      echo "⏾ your claim is released · $A_COUNT still live, awake until $([ "$A_UNTIL" = 0 ] && echo "further notice" || hhmm "$A_UNTIL")"
    fi
    settle "released by hand" "Blow" || exit 1
    return 0
  fi

  # No claim of ours, but somebody has one.
  if caller_is_human; then
    echo "⏾ you hold no claim; releasing all $total:"
    list_claims_indented
    local f
    while IFS= read -r f; do
      [ -n "$f" ] && retire_claim "$f" "released by a human holding no claim"
    done <<EOF
$(claim_files)
EOF
    settle "released by hand" "Blow" || exit 1
    return 0
  fi

  echo "simmer: you hold no claim, and these are not yours to end:" >&2
  list_claims_indented >&2
  die "nothing released. Ask the human, or wait for the deadline"
}

list_claims_indented() {
  local f
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    claim_read "$f" || continue
    local eff; eff="$(capped_until "$c_until")"
    printf '   %s %s%s · %s\n' "$(owner_glyph "$c_owner")" "$c_owner" \
      "${c_reason:+ · $c_reason}" \
      "$([ "$eff" = 0 ] && echo "no deadline" || echo "until $(hhmm "$eff")")"
  done <<EOF
$(claim_files)
EOF
  return 0
}

############################################################################
### cap -- the human ceiling
#
# The one command claims cannot argue with. `simmer cap 23:00` means nothing runs
# past 23:00 whoever asks; `simmer cap off` lifts it. It is deliberately a human
# instrument: an agent may read it -- and `budget` tells it the truth about the
# room left -- but moving it is not an agent's decision to make.
cmd_cap() {
  local arg=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner)      SIMMER_OWNER="${2:-}"; shift 2 ;;
      -r|--reason)  shift 2 ;;
      *)            [ -z "$arg" ] && arg="$1"; shift ;;
    esac
  done
  case "$arg" in
    "")
      if cap_read; then
        local n; n="$(now)"
        if [ "$cap_until" -le "$n" ]; then
          echo "⛔ cap $(hhmm "$cap_until") — passed, so nothing new can be claimed."
          echo "   'simmer cap off' lifts it, 'simmer cap <HH:MM>' moves it."
        else
          echo "⛔ nothing past $(hhmm "$cap_until") ($(human_duration $((cap_until - n))) from now)${cap_set_by:+ · set by $cap_set_by}"
        fi
      else
        echo "no cap · claims are bounded only by their own deadlines"
      fi
      return 0 ;;
    off|none|clear|lift)
      caller_is_human || die "only a person can lift the cap"
      if [ -f "$CAP" ]; then
        rm -f "$CAP"; log "cap lifted by $(current_owner)"
        echo "cap lifted"
      else echo "no cap was set"; fi
      refresh_menubar
      return 0 ;;
  esac

  caller_is_human || die "only a person can set the cap"
  local target n; n="$(now)"
  if target="$(parse_until "$arg" 2>/dev/null)"; then :
  else
    local secs; secs="$(parse_duration "$arg")" ||
      die "did not understand the cap: $arg (expected HH:MM, a duration, or 'off')"
    target=$((n + secs))
  fi
  cap_write "$target" "$(current_owner)"
  log "cap set to $(hhmm "$target") by $(current_owner)"
  echo "⛔ nothing past $(hhmm "$target") ($(human_duration $((target - n))) from now)"

  # Clipping is immediate, not merely a promise about future claims. A claim
  # already reaching past the new cap has to come down now, or the ceiling would
  # not be one.
  local f clipped=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    claim_read "$f" || continue
    if [ "$c_until" = 0 ] || [ "$c_until" -gt "$target" ]; then
      c_until="$target"; c_warned=0; claim_write "$f"; clipped=$((clipped + 1))
    fi
  done <<EOF
$(claim_files)
EOF
  [ "$clipped" -gt 0 ] && echo "   clipped $clipped claim(s) back to it"
  settle "cap set to $(hhmm "$target")" "Tink"
  return 0
}

############################################################################
### run -- a claim scoped to a process lifetime
#
# `simmer run -- <cmd>` claims awake time, runs the command, and hands the claim
# back on ANY exit -- success, failure, signal. The claim shape that cannot be
# forgotten, because there is nothing to remember.
#
# Deliberately NOT one long claim for the whole run. An initial chunk
# (SIMMER_RUN_CHUNK, default 45m) that a background renewer refreshes every
# SIMMER_RUN_INTERVAL (default 20m) while the command is alive. Two things fall
# out of that shape: if this runner is SIGKILLed -- the one exit no trap can
# catch -- the claim still expires within one chunk, self-revoking by
# construction; and no open-ended reminders nag during a legitimate run.
#
# The owner is `run:<pid>`, which is the whole ownership story: two concurrent
# runs are two claims that cannot see each other, and the renewer and the cleanup
# address a file only they can name. v1 needed a pid token inside the reason to
# prove the same thing, because there was one slot for everyone.

RUN_OWNER=""; RUN_RENEW_PID=0

run_claim_alive() { [ -f "$(claim_path "$RUN_OWNER")" ]; }

run_renewer() { # <owner> <runner-pid> <interval-s> <chunk-s> <budget-epoch, 0 = uncapped>
  local owner="$1" runner="$2" interval="$3" chunk="$4" budget="$5"
  local file; file="$(claim_path "$owner")"
  local n target
  while :; do
    sleep "$interval" || return 0
    # Command over (or the runner SIGKILLed): stop. Cleanup or expiry takes over.
    kill -0 "$runner" 2>/dev/null || return 0
    # The guard may have retired us -- deadline, floor, charger, heat. Writing the
    # file again here would resurrect a claim the guard deliberately ended.
    claim_read "$file" || return 0
    n="$(now)"
    if [ "$budget" != 0 ] && [ "$n" -ge "$budget" ]; then
      # --max reached: the claim lapses, the command does NOT. Killing work is
      # never simmer's call -- the cap bounds the awake time, not the job.
      log "run: --max budget exhausted, no longer renewing ($c_reason)"
      notify "☕ run budget exhausted" "sleep re-allowed, command still running" \
             "$c_reason" "Tink"
      return 0
    fi
    target=$((n + chunk))
    [ "$budget" != 0 ] && [ "$target" -gt "$budget" ] && target="$budget"
    # The human cap outranks a renewal just as it outranks a claim.
    if cap_read && [ "$target" -gt "$cap_until" ]; then target="$cap_until"; fi
    if [ "$target" -gt "$c_until" ]; then
      c_until="$target"; c_warned=0
      claim_write "$file"
      log "run: renewed until $(date -r "$target" '+%H:%M:%S')"
    fi
  done
}

run_cleanup() {
  [ "$RUN_RENEW_PID" != 0 ] && kill "$RUN_RENEW_PID" 2>/dev/null || true
  # Release only what is still ours. If the command outlived the claim (--max
  # reached, or the guard retired it) there is nothing of ours to hand back.
  if run_claim_alive; then
    retire_claim "$(claim_path "$RUN_OWNER")" "run finished"
    settle "run finished" "Blow" || true
  fi
  return 0
}

cmd_run() {
  local reason="" max_seconds=0 chunk interval
  chunk="$(parse_duration "${SIMMER_RUN_CHUNK:-45m}")" ||
    die "SIMMER_RUN_CHUNK: did not understand the duration: ${SIMMER_RUN_CHUNK:-}"
  interval="$(parse_duration "${SIMMER_RUN_INTERVAL:-20m}")" ||
    die "SIMMER_RUN_INTERVAL: did not understand the duration: ${SIMMER_RUN_INTERVAL:-}"

  while [ $# -gt 0 ]; do
    case "$1" in
      -r|--reason) reason="${2:-}"; shift 2 ;;
      --max)       max_seconds="$(parse_duration "${2:-}")" || die "did not understand the duration: ${2:-}"; shift 2 ;;
      -f|--force)  echo "simmer: --force no longer does anything -- claims cannot collide" >&2; shift ;;
      --)          shift; break ;;
      *)           die "usage: simmer run [-r reason] [--max 2h] -- <command...>" ;;
    esac
  done
  [ $# -gt 0 ] || die "run what? simmer run -- <command...>"

  local start budget=0
  start="$(now)"
  [ "$max_seconds" -gt 0 ] && budget=$((start + max_seconds))
  RUN_OWNER="run:$$"

  local first="$chunk"
  [ "$budget" != 0 ] && [ "$max_seconds" -lt "$first" ] && first="$max_seconds"

  # Through cmd_take, not a private path: the battery floor, the cap and the
  # second caffeinate clock all apply unchanged.
  cmd_take "${first}s" -r "${reason:-$(basename "$1")}" --owner "$RUN_OWNER"

  run_renewer "$RUN_OWNER" $$ "$interval" "$chunk" "$budget" &
  RUN_RENEW_PID=$!

  # EXIT alone is not enough: bash does not run the EXIT trap when an untrapped
  # signal kills it, so INT/TERM/HUP convert to an exit first.
  trap run_cleanup EXIT
  trap 'exit 129' HUP
  trap 'exit 130' INT
  trap 'exit 143' TERM

  # The command's exit code is our exit code, untouched -- so its failure must
  # not trip set -e before we can capture it.
  local rc=0
  set +e
  "$@"
  rc=$?
  set -e
  exit "$rc"
}

############################################################################
### Status

# JSON needs exactly two escapes for correctness -- backslash and double quote --
# plus the control characters a reason could plausibly carry. Pure parameter
# expansion: /bin/bash on macOS is 3.2, and jq must not become a prerequisite
# for *producing* the state (the claim files stay key=value for the same reason).
json_escape() { # <string> -> the string, safe between double quotes
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

# The claims array. New in format=2 and therefore additive: every field the
# single-lease shape published is still at the top level, answered from the
# aggregate, so an existing reader keeps working and a new one can see the parts.
claims_json() {
  local n; n="$(now)"
  local f out="" first=1 eff left
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    claim_read "$f" || continue
    eff="$(capped_until "$c_until")"
    [ "$eff" != 0 ] && [ "$eff" -le "$n" ] && continue
    if [ "$eff" = 0 ]; then left=-1; else left=$((eff - n)); fi
    [ "$first" = 0 ] && out="$out,"
    first=0
    out="$out$(printf '{"id":"%s","owner":"%s","until":%s,"left":%s,"reason":"%s","min_battery":%s,"require_ac":%s,"since":%s,"human":%s}' \
      "$(json_escape "$c_id")" "$(json_escape "$c_owner")" "$eff" "$left" \
      "$(json_escape "$c_reason")" "$c_min_battery" "$c_require_ac" "$c_started" \
      "$(owner_is_human_name "$c_owner" && echo true || echo false)")"
  done <<EOF
$(claim_files)
EOF
  printf '%s' "$out"
}

cmd_status() {
  local porcelain=0 json=0
  case "${1:-}" in
    --machine|--porcelain) porcelain=1 ;;
    --json)                json=1 ;;
  esac

  local n; n="$(now)"
  aggregate

  if [ "$A_COUNT" = 0 ]; then
    if [ "$json" = 1 ]; then
      printf '{"state":"%s","battery":%s,"claim_count":0,"cap":%s,"claims":[],"version":"%s"}\n' \
        "$A_STATE" "$(battery_percent)" "$A_CAP" "$SIMMER_VERSION"
      return 0
    fi
    if [ "$porcelain" = 1 ]; then
      echo "state=$A_STATE"; echo "battery=$(battery_percent)"
      echo "claim_count=0"; echo "cap=$A_CAP"
      return 0
    fi
    if [ "$A_STATE" = orphan ]; then
      # Either set by hand, or the guard is not running. Both deserve saying.
      echo "⚠️  disablesleep is on but nothing claims it -- nobody will hand it back."
      echo "   'simmer down' reverts it, 'simmer 60m' turns it into a proper claim."
    else
      echo "⏾ sleep allowed · $(battery_line)"
    fi
    cap_note
    return 0
  fi

  if [ "$json" = 1 ]; then
    # Same top-level fields as before, answered from the aggregate, plus the
    # claims array, the count and the cap. Numbers stay numbers; everything that
    # can carry arbitrary text goes through json_escape.
    printf '{"state":"%s","until":%s,"left":%s,"left_short":"%s","reason":"%s","min_battery":%s,"battery":%s,"on_battery":%s,"sleep_disabled":%s,"since":%s,"owner":"%s","claim_count":%s,"cap":%s,"capped":%s,"claims":[%s],"version":"%s"}\n' \
      "$A_STATE" "$A_UNTIL" "$A_LEFT" \
      "$(json_escape "$A_LEFT_SHORT")" "$(json_escape "$A_REASON")" \
      "$A_MIN_BATTERY" "$(battery_percent)" \
      "$(on_battery && echo 1 || echo 0)" \
      "$(sleep_disabled && echo 1 || echo 0)" \
      "$A_SINCE" "$(json_escape "$A_OWNER")" "$A_COUNT" "$A_CAP" \
      "$([ "$A_CAPPED" = 1 ] && echo true || echo false)" \
      "$(claims_json)" "$SIMMER_VERSION"
    return 0
  fi

  if [ "$porcelain" = 1 ]; then
    echo "state=$A_STATE"
    echo "until=$A_UNTIL"
    echo "left=$A_LEFT"
    echo "left_short=$A_LEFT_SHORT"
    echo "reason=$A_REASON"
    echo "min_battery=$A_MIN_BATTERY"
    echo "battery=$(battery_percent)"
    echo "on_battery=$(on_battery && echo 1 || echo 0)"
    echo "sleep_disabled=$(sleep_disabled && echo 1 || echo 0)"
    echo "since=$A_SINCE"
    echo "owner=$A_OWNER"
    echo "claim_count=$A_COUNT"
    echo "cap=$A_CAP"
    return 0
  fi

  if [ "$A_UNTIL" = 0 ]; then
    echo "☕ simmering, no deadline · for $(human_duration $((n - A_SINCE)))${A_REASON:+ · $A_REASON}"
  else
    echo "☕ simmering until $(hhmm "$A_UNTIL") · $(human_duration "$A_LEFT") left${A_REASON:+ · $A_REASON}"
  fi
  # The parts, whenever there is more than one. With a single claim the line above
  # already said everything and repeating it is noise.
  [ "$A_COUNT" -gt 1 ] && list_claims_indented
  echo "   $(battery_line) · floor ${A_MIN_BATTERY}%"
  cap_note
  sleep_disabled || echo "   ⚠️  disablesleep is off despite a live claim -- the lid will not hold. 'simmer doctor'"
  return 0
}

cap_note() {
  cap_read || return 0
  local n; n="$(now)"
  if [ "$cap_until" -le "$n" ]; then
    echo "   ⛔ cap $(hhmm "$cap_until") has passed -- nothing new can be claimed ('simmer cap off')"
  else
    echo "   ⛔ nothing past $(hhmm "$cap_until")${cap_set_by:+ · set by $cap_set_by}"
  fi
  return 0
}

############################################################################
### budget -- the agent-facing question
#
# `--machine` says what the state IS. An agent needs to decide whether to START
# something: "is there room for another ten minutes of work, or do I write the
# handoff note instead?" Answering that from the raw seconds means every caller
# reimplements the same comparison, and gets the no-claim case wrong.
#
# So the decision lives here, in the exit code:
#
#   0  there is room (or no deadline at all)
#   1  not enough time left -- wind down
#   3  nothing claimed: sleep is allowed and the lid can interrupt at any moment
#
# 3 rather than 1 for "nothing claimed" on purpose: it is not a small budget, it
# is an absent guarantee. A caller that treats those the same will keep working
# while the machine sleeps under it.
#
# It answers over the AGGREGATE, because the aggregate is the machine's actual
# guarantee -- which is what the caller is really asking about. Whose claim
# provides it does not change how long the work has.

cmd_budget() {
  local need_seconds=0 bare=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --need)    need_seconds="$(parse_duration "${2:-}")" || die "did not understand the duration: ${2:-}"; shift 2 ;;
      # A bare integer, because the alternative is every caller regex-ing an
      # English sentence. -1 means no deadline. Only meaningful when the exit
      # code is 0 -- check that first.
      --seconds) bare=1; shift ;;
      # The whole answer as one object. Output only: the exit codes stay the
      # contract, so `budget --json --need 20m || wind_down` keeps working.
      --json)    json=1; shift ;;
      # Accepted and ignored. budget answers over the aggregate by contract, so
      # who is asking cannot change the answer -- but callers pass --owner to
      # every other command and dying on it here is a papercut with no upside.
      --owner)      shift 2 ;;
      -r|--reason)  shift 2 ;;
      *)         die "usage: simmer budget [--need 20m] [--seconds] [--json]" ;;
    esac
  done

  budget_json() { # <fits> <seconds_left> <state>
    printf '{"fits":%s,"seconds_left":%s,"state":"%s","need_seconds":%s,"claim_count":%s,"cap":%s,"capped":%s}\n' \
      "$1" "$2" "$3" "$need_seconds" "$A_COUNT" "$A_CAP" \
      "$([ "$A_CAPPED" = 1 ] && echo true || echo false)"
  }

  local n; n="$(now)"
  aggregate

  if [ "$A_COUNT" = 0 ]; then
    if [ "$json" = 1 ]; then
      # Nothing claimed, no clock: with --need nothing fits; without one there is
      # no question to answer. seconds_left is null -- an absent clock is not the
      # same thing as zero seconds on one.
      budget_json "$([ "$need_seconds" -gt 0 ] && echo false || echo null)" null "$A_STATE"
    elif [ "$bare" = 0 ]; then
      if [ "$A_STATE" = orphan ]; then
        echo "sleep disabled with nothing claiming it -- nobody will hand it back"
      else
        echo "nothing claimed -- sleep is allowed, the lid can interrupt at any time"
      fi
    fi
    return 3
  fi

  if [ "$A_UNTIL" = 0 ]; then
    if [ "$json" = 1 ]; then
      budget_json "$([ "$need_seconds" -gt 0 ] && echo true || echo null)" -1 forever
    elif [ "$bare" = 1 ]; then echo "-1"
    else echo "no deadline -- running for $(human_duration $((n - A_SINCE)))${A_REASON:+ · $A_REASON}"; fi
    return 0
  fi

  local left="$A_LEFT"
  local fits=null
  if [ "$need_seconds" -gt 0 ]; then
    if [ "$left" -lt "$need_seconds" ]; then fits=false; else fits=true; fi
  fi
  if [ "$json" = 1 ]; then budget_json "$fits" "$left" active
  elif [ "$bare" = 1 ]; then echo "$left"
  else
    echo "$(human_duration "$left") left of $(human_duration $((A_UNTIL - A_SINCE))) · until $(hhmm "$A_UNTIL")${A_REASON:+ · $A_REASON}"
    # The truthful answer to "why can I not have more", so an agent that hits the
    # ceiling reports it instead of retrying with a bigger number.
    [ "$A_CAPPED" = 1 ] && echo "that is the cap a human set -- asking for longer will not move it"
  fi
  [ "$fits" = false ] && return 1
  return 0
}

############################################################################
### render -- the core draws every surface
#
# One renderer per surface, all here, all reading the ledger directly. The
# front-end files are one-line shims that exec into these. Why: the previous
# design had three separate renderers parsing the same state in three languages
# of shell, which produced six copies of a binary-resolver, two Raycast commands
# that shipped dead, and a menu bar icon drawn twice. A fourth surface now costs
# a case branch here and a shim there, and is tested where everything else is.
#
# The menu bar shows the AGGREGATE -- what the machine will actually do -- and
# lists the claims underneath, each with its own release. The two jobs are
# ambient truth at zero clicks and the 80% actions at one; everything else is
# deliberately the CLI.

render_swiftbar() {
  local me="$SIMMER_HOME/bin/simmer"
  act() { # <label> <args...> -- a clickable menu entry
    local label="$1"; shift
    local line="$label | bash=\"$me\" terminal=false refresh=true"
    local i=1
    for a in "$@"; do line="$line param${i}=\"$a\""; i=$((i + 1)); done
    echo "$line"
  }
  aggregate
  local power="battery $(battery_percent)%$(on_battery && echo ", on battery" || echo ", on AC")"

  case "$A_STATE" in
    active)
      if [ "$A_LEFT" -le 300 ]; then echo "$A_LEFT_SHORT | sfimage=cup.and.saucer.fill color=orange"
      else                           echo "$A_LEFT_SHORT | sfimage=cup.and.saucer.fill"; fi
      echo "---"
      echo "Simmering until $(hhmm "$A_UNTIL") | sfimage=clock"
      [ "$A_CAPPED" = 1 ] && echo "— that is your cap | sfimage=hand.raised.fill"
      [ -n "$A_REASON" ] && echo "$A_REASON | sfimage=text.quote"
      echo "$power · floor ${A_MIN_BATTERY}% | sfimage=battery.50"
      sleep_disabled || echo "⚠️ disablesleep is off — the lid will not hold | color=red"
      render_claim_rows
      echo "---"
      act "Extend 15 minutes" "+15m" "--owner" "menubar"
      act "Extend 1 hour"     "+1h" "--owner" "menubar"
      act "Extend 3 hours"    "+3h" "--owner" "menubar"
      echo "---"
      act "Release mine" "down" "--owner" "menubar"
      act "Release everything" "down" "--all" "--owner" "menubar"
      ;;
    forever)
      echo "∞ | sfimage=cup.and.saucer.fill color=orange"
      echo "---"
      echo "Simmering with no deadline | sfimage=infinity"
      [ "$A_SINCE" != 0 ] && echo "since $(hhmm "$A_SINCE") | sfimage=clock"
      [ -n "$A_REASON" ] && echo "$A_REASON | sfimage=text.quote"
      echo "$power · floor ${A_MIN_BATTERY}% | sfimage=battery.50"
      render_claim_rows
      echo "---"
      echo "Convert to a deadline"
      act "-- 1 hour from now"  "1h" "--owner" "menubar"
      act "-- 3 hours from now" "3h" "--owner" "menubar"
      echo "---"
      act "Release mine" "down" "--owner" "menubar"
      act "Release everything" "down" "--all" "--owner" "menubar"
      ;;
    orphan)
      echo " | sfimage=exclamationmark.triangle.fill color=red"
      echo "---"
      echo "Sleep is disabled with nothing claiming it | color=red"
      echo "Nobody is scheduled to hand it back. Is the guard running?"
      echo "$power | sfimage=battery.50"
      echo "---"
      act "Revert now" "down" "--owner" "menubar"
      act "Turn it into a 1 hour claim" "1h" "--owner" "menubar"
      echo "Run simmer doctor | bash=\"$me\" param1=doctor terminal=true"
      ;;
    *)
      echo " | sfimage=moon.zzz"
      echo "---"
      echo "Sleep allowed | sfimage=moon.zzz"
      echo "$power | sfimage=battery.50"
      echo "---"
      echo "Stay awake for…"
      act "-- 30 minutes" "30m" "--owner" "menubar"
      act "-- 1 hour"     "1h" "--owner" "menubar"
      act "-- 2 hours"    "2h" "--owner" "menubar"
      act "-- 4 hours"    "4h" "--owner" "menubar"
      act "-- until further notice" "forever" "--owner" "menubar"
      ;;
  esac

  # The cap lives at the bottom in every state: it is the human's own control,
  # not a property of whatever happens to be claimed right now.
  echo "---"
  if [ "$A_CAP" != 0 ]; then
    echo "Nothing past $(hhmm "$A_CAP") | sfimage=hand.raised.fill"
    act "-- lift it" "cap" "off" "--owner" "menubar"
  else
    echo "Nothing past…"
    act "-- 22:00" "cap" "22:00" "--owner" "menubar"
    act "-- 23:00" "cap" "23:00" "--owner" "menubar"
    act "-- 01:00" "cap" "01:00" "--owner" "menubar"
  fi
  echo "---"
  echo "Log | bash=\"$me\" param1=log param2=40 terminal=true"
  echo "Refresh | refresh=true"
}

# One row per claim, each releasable on its own. Shown only when there is more
# than one: with a single claim the header above already said all of it.
# Called from inside a render, where aggregate has already run -- so it reads
# A_COUNT rather than recomputing it, which would reset the A_* the caller is
# still using.
render_claim_rows() {
  [ "$A_COUNT" -gt 1 ] || return 0
  echo "---"
  echo "$A_COUNT claims"
  local f eff n; n="$(now)"
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    claim_read "$f" || continue
    eff="$(capped_until "$c_until")"
    [ "$eff" != 0 ] && [ "$eff" -le "$n" ] && continue
    echo "$(owner_glyph "$c_owner") $c_owner${c_reason:+ · $c_reason} · $([ "$eff" = 0 ] && echo "no deadline" || echo "until $(hhmm "$eff")")"
  done <<EOF
$(claim_files)
EOF
  return 0
}

# One line for Raycast's inline mode: the answer with no selection made.
render_raycast() {
  aggregate
  local extra=""
  [ "$A_COUNT" -gt 1 ] && extra=" · $A_COUNT claims"
  case "$A_STATE" in
    active)  echo "☕ $A_LEFT_SHORT left · until $(hhmm "$A_UNTIL") · ${A_REASON:-no reason} · $(battery_percent)%$(on_battery && echo ' batt' || echo ' AC')$extra" ;;
    forever) echo "☕ no deadline · ${A_REASON:-no reason} · $(battery_percent)% · floor ${A_MIN_BATTERY}%$extra" ;;
    orphan)  echo "⚠️ sleep disabled with nothing claiming it — run: simmer down" ;;
    *)       echo "⏾ sleep allowed · $(battery_percent)%$(on_battery && echo ' batt' || echo ' AC')" ;;
  esac
}

render_alfred() { # <query>
  local QUERY="${1:-}"
  esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }
  local items=()
  item() { # <title> <subtitle> <arg|""> <icon>
    local valid=true; [ -z "$3" ] && valid=false
    items+=("$(printf '{"title":"%s","subtitle":"%s","arg":"%s","valid":%s,"icon":{"path":"%s"}}' \
      "$(esc "$1")" "$(esc "$2")" "$(esc "$3")" "$valid" "$4")")
  }
  local ICON_ON=/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/AlertNoteIcon.icns
  local ICON_OFF=/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/SleepFolderIcon.icns
  local ICON_WARN=/System/Library/CoreServices/CoreTypes.bundle/Contents/Resources/AlertCautionIcon.icns

  aggregate
  local power="battery $(battery_percent)%$(on_battery && echo ', on battery' || echo ', on AC')"
  local dq=""
  if [[ "$QUERY" =~ ^\+?[0-9]+[hms]?[a-z0-9]*$ ]] || [[ "$QUERY" =~ ^[0-9]{1,2}:[0-9]{2}$ ]]; then dq="$QUERY"; fi

  case "$A_STATE" in
    active)
      item "Simmering until $(hhmm "$A_UNTIL") · $A_LEFT_SHORT left" \
           "${A_REASON:-no reason given} — $power, floor ${A_MIN_BATTERY}%$([ "$A_COUNT" -gt 1 ] && echo ", $A_COUNT claims")" "" "$ICON_ON"
      sleep_disabled || item "Warning: disablesleep is off" "The lid will not hold. Run simmer doctor." "" "$ICON_WARN"
      if [ -n "$dq" ]; then
        case "$dq" in
          *:*) item "Move your deadline to $dq" "Replaces your own claim" "--until $dq" "$ICON_ON" ;;
          +*)  item "Extend by ${dq#+}"         "Counted from now"        "$dq"         "$ICON_ON" ;;
          *)   item "Replace yours with $dq"    "Counted from now"        "$dq"         "$ICON_ON" ;;
        esac
      fi
      item "Release mine"      "Hand your own claim back"               "down"       "$ICON_OFF"
      item "Release everything" "Ends every claim -- humans only"       "down --all" "$ICON_OFF"
      item "Extend 15 minutes" "Deadline moves to 15 minutes from now"  "+15m"       "$ICON_ON"
      item "Extend 1 hour"     "Deadline moves to 1 hour from now"      "+1h"        "$ICON_ON"
      ;;
    forever)
      item "Simmering with no deadline · since $(hhmm "$A_SINCE")" \
           "${A_REASON:-no reason given} — $power, floor ${A_MIN_BATTERY}%" "" "$ICON_ON"
      [ -n "$dq" ] && item "Give it a deadline: $dq" "Turns the open-ended claim into a timebox" "${dq#+}" "$ICON_ON"
      item "Release mine" "Hand your own claim back" "down" "$ICON_OFF"
      item "Release everything" "Ends every claim -- humans only" "down --all" "$ICON_OFF"
      ;;
    orphan)
      item "Sleep is disabled with nothing claiming it" "Nobody is scheduled to hand it back — is the guard running?" "" "$ICON_WARN"
      item "Revert now" "Allow sleep again immediately" "down" "$ICON_OFF"
      item "Turn it into a 1 hour claim" "Keeps it awake, with a deadline" "1h" "$ICON_ON"
      ;;
    *)
      item "Sleep allowed" "$power — nothing is holding this Mac awake" "" "$ICON_OFF"
      if [ -n "$dq" ]; then
        case "$dq" in
          *:*) item "Stay awake until $dq" "Lid may close until then" "--until $dq" "$ICON_ON" ;;
          *)   item "Stay awake for ${dq#+}" "Lid may close until then" "${dq#+}" "$ICON_ON" ;;
        esac
      fi
      item "30 minutes" "Lid may close until then" "30m" "$ICON_ON"
      item "1 hour"     "Lid may close until then" "1h"  "$ICON_ON"
      item "2 hours"    "Lid may close until then" "2h"  "$ICON_ON"
      item "Until further notice" "No deadline — reminds every 30 minutes" "forever" "$ICON_ON"
      ;;
  esac
  [ "$A_CAP" != 0 ] && item "Nothing past $(hhmm "$A_CAP")" "The cap a human set — 'cap off' lifts it" "cap off" "$ICON_WARN"
  printf '{"items":[%s]}\n' "$(IFS=,; echo "${items[*]}")"
}

cmd_render() { # <surface> [args]
  case "${1:-}" in
    swiftbar) render_swiftbar ;;
    raycast)  render_raycast ;;
    alfred)   shift || true; render_alfred "${1:-}" ;;
    *) die "usage: simmer render swiftbar|raycast|alfred [query]" ;;
  esac
}

############################################################################
### The guard
#
# Runs every 30 seconds under launchd, and at login. It is the reason this tool
# is safe to carry around: handing the switch back does not depend on a terminal
# you closed or a process you killed.
#
# With a ledger it retires claims one at a time and lets `settle` decide about
# the switch, which means a machine held awake by three actors comes back down in
# three steps rather than all-or-nothing, and the last claim out turns the light
# off. Heat is the exception: it ends everything at once, because it is a fact
# about the machine rather than about anybody's plan for it.

cmd_guard() {
  export SIMMER_NONINTERACTIVE=1
  local n; n="$(now)"

  if [ "$(claim_count)" = 0 ]; then
    # Nothing claimed but the switch is on: set by hand, or a crash mid-release.
    # Either way it goes back -- this is the self-healing that makes the
    # forgotten switch structurally impossible.
    if sleep_disabled; then
      switch_back "found disablesleep with nothing claiming it" "Basso" || exit 1
      refresh_menubar
    fi
    exit 0
  fi

  # Heat: release everything and say so. Deliberately not a warning -- with the
  # lid closed nobody sees a warning, and the machine cannot vent on a duvet in a
  # bag.
  if thermal_pressure; then
    local f
    while IFS= read -r f; do
      [ -n "$f" ] && retire_claim "$f" "thermal pressure"
    done <<EOF
$(claim_files)
EOF
    settle "thermal pressure -- letting it cool" "Basso" || exit 1
    exit 0
  fi

  local pct; pct="$(battery_percent)"
  local onbatt=0; on_battery && onbatt=1
  local why="" f eff

  while IFS= read -r f; do
    [ -n "$f" ] || continue
    claim_read "$f" || continue
    eff="$(capped_until "$c_until")"

    # Deadline passed -- the claim's own, or the cap clipping it.
    if [ "$eff" != 0 ] && [ "$n" -ge "$eff" ]; then
      why="time is up$([ -n "$c_reason" ] && echo " · $c_reason")"
      retire_claim "$f" "time is up"
      continue
    fi

    # Battery below this claim's floor. Only on battery power -- on AC the charge
    # level is irrelevant, and while charging this would abort for no reason.
    #
    # Per claim rather than all at once, so an actor asking for a 60% floor gets
    # exactly that without dragging everyone else's time down with it. With the
    # default floor everywhere -- the normal case -- they all go together anyway.
    if [ "$onbatt" = 1 ] && [ -n "$pct" ] && [ "$pct" -le "$c_min_battery" ]; then
      why="battery ${pct}% below floor ${c_min_battery}%"
      retire_claim "$f" "$why"
      continue
    fi

    # The charger went away and this claim said it needed one. An overnight claim
    # is only sane on mains power, and the moment the cable goes the assumption
    # behind it is gone too -- so it ends now, at 90%, rather than at the floor
    # hours later.
    if [ "$c_require_ac" = 1 ] && [ "$onbatt" = 1 ]; then
      why="charger unplugged (--require-ac)"
      retire_claim "$f" "$why"
      continue
    fi

    # Approaching the floor. The point of warning early is that plugging in is
    # still an option; at the floor itself the only thing left to report is that
    # it is over. Re-arms when the battery climbs back out of the window, so
    # plugging in and later unplugging warns again.
    if [ "$onbatt" = 1 ] && [ -n "$pct" ] && [ "$pct" -le $((c_min_battery + PREFLOOR_MARGIN)) ]; then
      if [ "$c_prewarned" = 0 ]; then
        c_prewarned=1; claim_write "$f"
        notify "🔌 Battery ${pct}%, floor ${c_min_battery}%" "plug in, or simmer hands the switch back soon" \
               "${c_reason:-$c_owner}" "Tink"
        log "pre-floor warning for $c_owner at ${pct}% (floor ${c_min_battery}%)"
      fi
    elif [ "$c_prewarned" != 0 ]; then
      c_prewarned=0; claim_write "$f"
    fi
  done <<EOF
$(claim_files)
EOF

  # The switch follows the ledger. If that loop retired the last claim, this is
  # where the machine is handed back.
  settle "${why:-guard tick}" "Basso" || exit 1

  aggregate
  [ "$A_COUNT" = 0 ] && exit 0

  # One warning, exactly once -- against the AGGREGATE deadline, because that is
  # when the machine actually sleeps. The flag lives on the claim that defines
  # that deadline, which gives the right behaviour for free: when that claim goes
  # and a shorter one becomes the aggregate, the new deadline gets its own
  # warning instead of inheriting a spent one.
  if [ "$A_UNTIL" != 0 ]; then
    local left=$((A_UNTIL - n))
    if [ "$left" -le "$WARN_SECONDS" ] && [ -n "$A_FILE" ] && claim_read "$A_FILE" && [ "$c_warned" = 0 ]; then
      c_warned=1; claim_write "$A_FILE"
      notify "☕ $(human_duration "$left") left" "then this Mac sleeps" \
             "simmer +30m extends it.${A_REASON:+ · $A_REASON}" "Tink"
      refresh_menubar
    fi
  else
    # No deadline: remind regularly. An open-ended claim must be impossible to
    # forget -- that was the condition under which it is allowed at all.
    if [ -n "$A_FILE" ] && claim_read "$A_FILE" && [ $((n - c_reminded)) -ge "$REMIND_SECONDS" ]; then
      c_reminded="$n"; claim_write "$A_FILE"
      notify "☕ Still simmering, no deadline" \
             "running $(human_duration $((n - c_started)))" \
             "${c_reason:-simmer down ends it.}" "Purr"
    fi
  fi
  return 0
}

############################################################################
### doctor

cmd_doctor() {
  local ok=0 fail=0
  say() { if eval "$2" >/dev/null 2>&1; then echo "✅ $1"; ok=$((ok+1)); else echo "❌ $1"; fail=$((fail+1)); fi; }

  echo "simmer $SIMMER_VERSION"
  echo "==================="
  # The runtime checks, and only those: doctor is the installed binary talking
  # about the running system, so it must work with no repo checked out. The
  # install-time checks (symlink, agent template current) belong to
  # install.sh, which calls this rather than repeating it.
  say "guard loaded ($GUARD_LABEL)"        "launchctl print gui/$(id -u)/$GUARD_LABEL"
  # -nl asks sudo whether the command is *allowed*, without running it and
  # without ever prompting. Testing with `sudo -n pmset -g` would fail even
  # with the rule installed, because -g is deliberately not in the allowlist.
  say "passwordless pmset rule"            "sudo -nl $PMSET -a disablesleep 0"
  if [ -x "$NOTIFIER_BIN" ]; then
    say "notifier bundle authorized"          "[ \"\$('$NOTIFIER_BIN' --status)\" = authorized ]"
  else
    say "notification fallback (osascript)"   "command -v osascript"
  fi
  say "claims directory writable"          "[ -w '$CLAIMS' ]"
  say "caffeinate present"                 "command -v caffeinate"
  # 60s of grace is a deliberate choice a human can make; five minutes is a
  # laptop that walks away unlocked. The line between them is the threshold.
  say "screen locks within 60s of lid close"  "[ \"\$(lock_delay_seconds || echo 999)\" -le 60 ]"
  # Informational, never red: a passed cap is a human decision working as
  # intended, and a check that is permanently red teaches people to skim the
  # whole report.
  if cap_read; then
    if [ "$cap_until" -le "$(now)" ]; then
      echo "ℹ️  the cap ($(hhmm "$cap_until")) has passed -- nothing new can be claimed until 'simmer cap off'"
    else
      echo "ℹ️  cap in force: nothing past $(hhmm "$cap_until")"
    fi
  fi
  echo
  echo "State:"
  cmd_status | sed 's/^/  /'
  echo "  (machine-readable: simmer status --json · simmer budget --json)"
  echo

  if [ "$fail" -gt 0 ]; then
    echo "Anything red above is fixed by re-running the installer:"
    echo "  cd <the simmer repo> && make install"
    echo
    echo "Except the sudo rule, which needs root and is therefore yours to run."
    echo "make install prints the exact command with your username filled in."
    echo
  fi

  # Which channel is about to be used matters more than a generic warning: they
  # fail for completely different reasons.
  if [ -x "$NOTIFIER_BIN" ]; then
    case "$("$NOTIFIER_BIN" --status 2>/dev/null)" in
      authorized)    echo "Notifications post as \"Simmer\", with simmer's own icon." ;;
      notDetermined) echo "Simmer's permission banner is pending -- click Allow when it"
                     echo "appears (make install fires it again)." ;;
      *)             echo "Notifications for \"Simmer\" were DENIED. Re-enable in"
                     echo "System Settings > Notifications > Simmer." ;;
    esac
  else
    echo "No notifier bundle (no swift compiler at install time?), so banners post"
    echo "as \"Script Editor\". Fix: xcode-select --install, then make install."
  fi
  echo
  echo "Firing one now."
  notify "simmer doctor" "notifications are working" "This banner is the test." "Tink"
  [ "$fail" -gt 0 ] && return 1 || return 0
}

############################################################################
### help
#
# Written out rather than printed from the file header. The header explains *why*
# the tool is built this way, which is what a maintainer needs and exactly what
# someone typing --help does not.

cmd_help() {
  cat <<'HELP'
simmer keeps this Mac awake for a while -- lid closed -- then lets it sleep again.

TRY THIS
  simmer 2h                  stay awake for two hours
  simmer 2h -r "big build"   ...and say what for, so you can see it later
  simmer run -- npm test     stay awake exactly as long as this command runs
  simmer                     how much longer? what for? who else is asking?
  simmer +30m                need longer: 30 more minutes from now
  simmer down                finished early, let it sleep

HOW LONG
  simmer 45                  45 minutes -- a bare number means minutes
  simmer 90m                 90 minutes
  simmer 2h                  two hours
  simmer 1h30m               an hour and a half
  simmer --until 23:00       until 11pm tonight
  simmer forever             no end time; it reminds you every 30 minutes

EVERYONE GETS THEIR OWN CLAIM
  Awake time is counted, not owned. You, an agent and a build can each hold a
  claim; the Mac stays awake until the last one ends, and nobody can take
  anybody else's away. So there is no --force any more, and nothing to
  negotiate.

  simmer status              every live claim, and when the machine actually sleeps
  simmer down                hand back YOUR claim
  simmer down --all          hand back everything (only a person may)

  simmer cap 23:00           nothing past 23:00, whoever asks and however long
  simmer cap                 what the cap is
  simmer cap off             lift it
                             The cap is yours alone. Claims ask from below; it
                             rules from above, and an agent that runs into it is
                             told so plainly instead of finding an error to
                             route around.

IT STOPS BY ITSELF WHEN
  a claim's time runs out  ·  the battery drops below 20%  ·  the charger goes,
  if the claim asked for one  ·  the chip reports thermal pressure  ·  you run
  simmer down

  You get a notification five minutes before the end, one when the battery gets
  within 10 points of the floor, and another when it stops. Even if you close
  the terminal, log out, or the tool crashes, a background watchdog puts the
  machine back to normal. That is the point of it.

CHANGING THE DEFAULTS
  -r "text"                  what this is for; shown in the menu bar and log
  --min-battery 30           let go under 30% instead of 20%
                             (ignored while plugged in -- charge does not matter then)
  --require-ac               end the claim the moment the charger is unplugged
  --until 23:00              an absolute time instead of a length
  --display-on               keep the screen lit too (default: the screen may
                             sleep -- the Mac stays awake either way)
  --owner <name>             who is asking. It names your claim, and it is what
                             the menu bar shows. Several agents at once should
                             each pick their own (--owner agent:funnel)
  --max 2h                   with simmer run: hard cap on total awake time.
                             When it is reached the claim lapses but the
                             command keeps running -- simmer never kills work

CHECKING ON IT
  simmer log                 what the watchdog has actually done
  simmer doctor              is everything wired up? fires a test notification
  simmer notify-test         one banner per transport -- see which your Mac shows
  simmer --version

  Day to day you do not need any of this: the menu bar shows the countdown and
  can extend or release it. See the README for SwiftBar and Raycast setup.

FOR SCRIPTS AND AGENTS
  simmer budget --need 20m   "is there room to start a 20-minute job?"
                               exit 0  yes, or there is no deadline at all
                               exit 1  less than that remains
                               exit 3  nothing is holding the Mac awake
  simmer budget --seconds    just the seconds remaining (-1 = no deadline)
  simmer status --json       the whole state as one JSON object (budget --json too),
                             aggregate at the top level, every claim in .claims
  simmer status --machine    the same as key=value lines, when jq is not around

  See docs/FOR-AGENTS.md for how an agent should use these together.

https://github.com/moralesl/simmer
HELP
}

############################################################################
### Entry point

case "${1:-status}" in
  # `shift` with no arguments returns non-zero, and under `set -e` that ended
  # the script before it printed anything. Bare `simmer` is the most common call
  # there is -- it must not be the one that silently does nothing.
  status)              shift || true; cmd_status "$@" ;;
  --machine)           cmd_status --machine ;;
  --porcelain)         cmd_status --machine ;;   # kept, undocumented
  --json)              cmd_status --json ;;
  down|off|stop|release) shift || true; cmd_down "$@" ;;
  cap)                 shift || true; cmd_cap "$@" ;;
  guard)               cmd_guard ;;
  doctor)              cmd_doctor ;;
  budget)              shift || true; cmd_budget "$@" ;;
  run)                 shift || true; cmd_run "$@" ;;
  notify-test)         cmd_notify_test ;;
  render)              shift || true; cmd_render "$@" ;;
  extend)              shift || true; cmd_extend "$@" ;;
  +*)                  cmd_extend "$@" ;;
  log)                 [ -f "$LOG" ] && tail -n "${2:-20}" "$LOG" || echo "no log yet" ;;
  -V|--version)        echo "simmer $SIMMER_VERSION" ;;
  -h|--help|help)      cmd_help ;;
  *)                   cmd_take "$@" ;;
esac
