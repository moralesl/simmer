<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The watchdog for `simmer`.

  Template: __SIMMER__ and __HOME__ are substituted at install time, because
  launchd expands neither ~ nor $HOME inside ProgramArguments.

  StartInterval 30: the guard is what hands `pmset disablesleep` back. Half a
  minute of slack on a 60-minute box is invisible, and a tick costs a few
  milliseconds of CPU -- nothing next to keeping the machine awake at all.

  RunAtLoad is the important half: at login the guard finds a disablesleep left
  over from a crash or a hand-typed pmset and reverts it. That is what makes
  "forgot to switch it back" structurally impossible rather than merely unlikely.

  The guard never prompts for a password -- it uses `sudo -n` only, which is why
  sudoers.d/simmer exists. Without that rule it logs the failure and notifies
  instead of hanging forever on an invisible prompt.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.github.moralesl.simmer-guard</string>

  <key>ProgramArguments</key>
  <array>
    <string>__SIMMER__/bin/simmer</string>
    <string>guard</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>TZ</key>
    <string>Europe/Berlin</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartInterval</key>
  <integer>30</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>

  <key>StandardOutPath</key>
  <string>__HOME__/.local/state/simmer/guard.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.local/state/simmer/guard.error.log</string>
</dict>
</plist>
