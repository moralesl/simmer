<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The backstop half of the guard (BRIEF.md): the app's IOKit callbacks answer
  instantly, this ticks every 30 seconds and at login over the same idempotent
  tick(). RunAtLoad is what heals a disablesleep left on by a crash or typed
  by hand - the property that makes forgetting structurally impossible.
  A login item can be quit; launchd cannot.
-->
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@CLI@</string>
		<string>guard</string>
	</array>
	<!--
	  launchd agents inherit nothing from the shell that installed them, and
	  the ledger's location is an environment variable. Without this the guard
	  read ${HOME}/.local/state while a shell exporting XDG_STATE_HOME read
	  somewhere else - two ledgers settling one global switch, in opposite
	  directions, every 30 seconds, converging never. `down` said "sleep
	  allowed again" and the next tick turned it straight back on.
	  XDG_STATE_HOME is the documented state location (CONTRACTS.md) and not
	  merely a test seam, so the value the installing shell resolved is baked
	  in here, and `doctor` compares the two.
	-->
	<key>EnvironmentVariables</key>
	<dict>
		<key>XDG_STATE_HOME</key>
		<string>@STATE_HOME@</string>
	</dict>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
