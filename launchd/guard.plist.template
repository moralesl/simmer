<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  The backstop half of the guard (BRIEF.md): the app's IOKit callbacks answer
  instantly, this ticks every 30 seconds and at login over the same idempotent
  tick(). RunAtLoad is what heals a disablesleep left on by a crash or typed
  by hand - the property that makes forgetting structurally impossible.
  A login item can be quit; launchd cannot.
-->
<dict>
	<key>Label</key>
	<string>@LABEL@</string>
	<key>ProgramArguments</key>
	<array>
		<string>@CLI@</string>
		<string>guard</string>
	</array>
	<key>StartInterval</key>
	<integer>30</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
</dict>
</plist>
